            <ProtectedString name="Source"><![CDATA[-- 自動測試：只在 Studio 裡執行，結果印在 Output 視窗。
-- 按 Play 後看 Output，應該會出現「[SelfTest] 全部通過」。

local RunService = game:GetService("RunService")
if not RunService:IsStudio() then
	return
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Achievements = require(Shared:WaitForChild("Achievements"))
local Cargo = require(Shared:WaitForChild("Cargo"))
local Crime = require(Shared:WaitForChild("Crime"))
local Jobs = require(Shared:WaitForChild("Jobs"))
local BargainSystem = require(Shared:WaitForChild("BargainSystem"))
local CodexSystem = require(Shared:WaitForChild("CodexSystem"))
local Config = require(Shared:WaitForChild("Config"))
local GalacticNews = require(Shared:WaitForChild("GalacticNews"))
local Progression = require(Shared:WaitForChild("Progression"))
local CustomerGenerator = require(Shared:WaitForChild("CustomerGenerator"))
local ItemDatabase = require(Shared:WaitForChild("ItemDatabase"))
local PlayerDataSchema = require(Shared:WaitForChild("PlayerDataSchema"))
local Tools = require(Shared:WaitForChild("Tools"))

local passed, failed = 0, 0

local function check(name, condition)
	if condition then
		passed += 1
	else
		failed += 1
		warn("[SelfTest] 失敗：" .. name)
	end
end

local function test(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		failed += 1
		warn("[SelfTest] 出錯：" .. name .. " → " .. tostring(err))
	end
end

-- 固定序列的「隨機」函式
local function sequence(values)
	local i = 0
	return function()
		i = i % #values + 1
		return values[i]
	end
end

test("議價：底價與開價", function()
	local floorLow, askLow = BargainSystem.GetPrices(100, 0)
	local floorHigh, askHigh = BargainSystem.GetPrices(100, 1)
	check("不貪婪的底價 = 55", floorLow == 55)
	check("最貪婪的底價 = 90", floorHigh == 90)
	check("不貪婪的開價 = 115", askLow == 115)
	check("最貪婪的開價 = 150", askHigh == 150)
	check("開價 >= 底價", askLow >= floorLow and askHigh >= floorHigh)
end)

test("議價：出價達到底價就成交", function()
	local floorPrice = BargainSystem.GetPrices(200, 0.5)
	local result = BargainSystem.Negotiate(floorPrice, 200, 100, 0.5)
	check("成交", result.Success == true)
	check("成交價 = 出價", result.FinalPrice == floorPrice)
	check("成交不扣耐心", result.NewPatience == 100)
end)

test("議價：出價太低會扣耐心並還價", function()
	local floorPrice, askingPrice = BargainSystem.GetPrices(200, 0.5)
	local result = BargainSystem.Negotiate(floorPrice - 1, 200, 100, 0.5)
	check("不成交", result.Success == false)
	check("沒有破局", result.DealFailed == false)
	check("耐心減少", result.NewPatience < 100)
	check("有還價", result.CounterOffer ~= nil)
	check("還價介於底價與開價", result.CounterOffer >= floorPrice and result.CounterOffer <= askingPrice)
end)

test("議價：亂砍價扣比較多", function()
	local small = BargainSystem.Negotiate(100, 200, 100, 0.5)
	local big = BargainSystem.Negotiate(1, 200, 100, 0.5)
	check("差距越大扣越多", big.NewPatience < small.NewPatience)
end)

test("議價：耐心歸零就破局", function()
	local result = BargainSystem.Negotiate(1, 200, 10, 0.5)
	check("破局", result.DealFailed == true)
	check("耐心 = 0", result.NewPatience == 0)
end)

test("議價：不合法的出價", function()
	local nan = 0 / 0
	for _, bad in { 0, -5, nan, math.huge } do
		local result = BargainSystem.Negotiate(bad, 200, 50, 0.5)
		check("不合法出價不成交：" .. tostring(bad), result.Success == false and result.DealFailed == false)
		check("不合法出價不扣耐心：" .. tostring(bad), result.NewPatience == 50)
	end
end)

test("物品資料庫：每件物品都設定正確", function()
	for _, item in ItemDatabase.GetAll() do
		local attrs = item.InspectionAttributes
		check(item.ID .. " 的 FakeTell 工具存在", Tools.List[attrs.FakeTell.Tool] ~= nil)
		check(item.ID .. " 的 Defect 工具存在", Tools.List[attrs.Defect.Tool] ~= nil)
		check(item.ID .. " 的稀有度有權重", ItemDatabase.RarityWeights[item.Rarity] ~= nil)
		check(item.ID .. " 的機率在 0~1", attrs.FakeChance >= 0 and attrs.FakeChance <= 1 and attrs.Defect.Chance >= 0 and attrs.Defect.Chance <= 1)
		check(item.ID .. " 可以用 Get 找到", ItemDatabase.Get(item.ID) == item)
	end
	check("開店時就有物品可以遇到", #ItemDatabase.GetEligible(0) > 0)
end)

test("物品資料庫：市場價值", function()
	local item = ItemDatabase.Get("Item_002")
	local defect = item.InspectionAttributes.Defect
	check("真品 = 基礎價值", ItemDatabase.GetMarketValue({ ItemId = "Item_002", IsFake = false }) == item.BaseValue)
	check("假貨 = 5%", ItemDatabase.GetMarketValue({ ItemId = "Item_002", IsFake = true }) == math.floor(item.BaseValue * 0.05))
	check("瑕疵品打折", ItemDatabase.GetMarketValue({ ItemId = "Item_002", IsFake = false, DefectType = defect.Type }) == math.floor(item.BaseValue * defect.ValueMultiplier))
	check("未知物品 = 0", ItemDatabase.GetMarketValue({ ItemId = "Nope", IsFake = false }) == 0)
end)

test("物品資料庫：鑑定", function()
	local item = ItemDatabase.Get("Item_002")
	local attrs = item.InspectionAttributes
	local fake = ItemDatabase.Inspect({ ItemId = "Item_002", IsFake = true }, attrs.FakeTell.Tool)
	check("用對的工具會看出假貨", fake[1].Text == attrs.FakeTell.FakeText and fake[1].Tone == "bad")
	local real = ItemDatabase.Inspect({ ItemId = "Item_002", IsFake = false }, attrs.FakeTell.Tool)
	check("用對的工具會確認真品", real[1].Text == attrs.FakeTell.RealText and real[1].Tone == "good")
	local defect = ItemDatabase.Inspect({ ItemId = "Item_002", IsFake = false, DefectType = attrs.Defect.Type }, attrs.Defect.Tool)
	check("用對的工具會看出瑕疵", defect[1].Text == attrs.Defect.FoundText)
	local nothing = ItemDatabase.Inspect({ ItemId = "Item_002", IsFake = true }, "Analyzer")
	check("不相關的工具看不出東西", #nothing == 1 and nothing[1].Tone == "neutral")
end)

test("客人產生器", function()
	local customer = CustomerGenerator.Generate(0, sequence({ 0.1, 0.9, 0.5, 0.3, 0.7 }), "test-id")
	local def = ItemDatabase.Get(customer.Item.ItemId)
	check("物品存在", def ~= nil)
	check("名聲 0 只會遇到門檻 0 的物品", def.MinReputation == 0)
	check("耐心從 100 開始", customer.Patience == 100)
	check("目前開價 = 開價", customer.CurrentAsk == customer.AskingPrice)
	check("使用傳入的 id", customer.Id == "test-id")
	check("假貨不會同時有瑕疵", not (customer.Item.IsFake and customer.Item.DefectType ~= nil))

	-- 極端的隨機值也不會出錯
	for _, value in { 0, 0.999999 } do
		local c = CustomerGenerator.Generate(100, function()
			return value
		end)
		check("極端隨機值也能產生客人：" .. tostring(value), ItemDatabase.Get(c.Item.ItemId) ~= nil)
	end
end)

test("存檔結構", function()
	local fresh = PlayerDataSchema.New()
	check("初始星幣 300", fresh.Credits == 300)
	check("初始有放大鏡", fresh.UnlockedTools.Magnifier == true)
	fresh.Inventory[1] = { Uid = "x" }
	check("New 是深拷貝", #PlayerDataSchema.Template.Inventory == 0)

	local old = { Credits = 42, UnlockedTools = { XRay = true } }
	local reconciled = PlayerDataSchema.Reconcile(old)
	check("Reconcile 保留舊值", reconciled.Credits == 42 and reconciled.UnlockedTools.XRay == true)
	check("Reconcile 補上新欄位", reconciled.Stats ~= nil and reconciled.Stats.DealsMade == 0 and reconciled.Reputation == 0)
	check("Reconcile 補上放大鏡", reconciled.UnlockedTools.Magnifier == true)
	check("Reconcile 處理壞資料", PlayerDataSchema.Reconcile("garbage").Credits == 300)
end)

test("經濟：認真鑑定、照底價收購的真品一定賺", function()
	for _, item in ItemDatabase.GetAll() do
		local floorHigh = BargainSystem.GetPrices(item.BaseValue, 1)
		check(item.ID .. " 最貪婪客人的底價 < 市價", floorHigh < item.BaseValue)
	end
end)

test("變種：閃亮與彩虹", function()
	local base = ItemDatabase.Get("Item_002").BaseValue
	check("閃亮版價值 ×3", ItemDatabase.GetMarketValue({ ItemId = "Item_002", IsFake = false, Variant = "Shiny" }) == base * 3)
	check("彩虹版價值 ×10", ItemDatabase.GetMarketValue({ ItemId = "Item_002", IsFake = false, Variant = "Rainbow" }) == base * 10)
	check("閃亮假貨還是不值錢", ItemDatabase.GetMarketValue({ ItemId = "Item_002", IsFake = true, Variant = "Shiny" }) == math.floor(base * 3 * 0.05))
	check("顯示名稱有變種標記", ItemDatabase.GetDisplayName("Item_002", "Shiny") == "【閃亮】" .. ItemDatabase.Get("Item_002").Name)
	check("普通版名稱不變", ItemDatabase.GetDisplayName("Item_002", "Normal") == ItemDatabase.Get("Item_002").Name)

	-- 第 2 次隨機值決定變種
	local rainbow = CustomerGenerator.Generate(0, sequence({ 0.1, 0.001, 0.9, 0.9, 0.5 }))
	check("隨機值很小時出彩虹版", rainbow.Item.Variant == "Rainbow")
	local shiny = CustomerGenerator.Generate(0, sequence({ 0.1, 0.03, 0.9, 0.9, 0.5 }))
	check("隨機值偏小時出閃亮版", shiny.Item.Variant == "Shiny")
	local normal = CustomerGenerator.Generate(0, sequence({ 0.1, 0.5, 0.9, 0.9, 0.5 }))
	check("一般情況是普通版", normal.Item.Variant == "Normal")
	local shinyFloor = BargainSystem.GetPrices(ItemDatabase.Get(shiny.Item.ItemId).BaseValue * 3, shiny.Greed)
	check("閃亮版的底價跟著變高", shiny.Floor == shinyFloor)

	local patient = CustomerGenerator.Generate(0, sequence({ 0.5 }), nil, { Patience = 125 })
	check("可以指定初始耐心", patient.Patience == 125 and patient.MaxPatience == 125)
end)

test("銀河新聞", function()
	local war = GalacticNews.Get("War")
	check("戰爭讓武器變貴", GalacticNews.GetPriceMultiplier(war, "Weapon") == 2)
	check("戰爭不影響美食", GalacticNews.GetPriceMultiplier(war, "Food") == 1)
	check("戰爭讓武器假貨變多", GalacticNews.GetFakeChanceBonus(war, "Weapon") > 0)
	check("平靜的一天沒有影響", GalacticNews.GetPriceMultiplier(GalacticNews.Get("Calm"), "Weapon") == 1)
	check("沒有新聞也不會出錯", GalacticNews.GetPriceMultiplier(nil, "Weapon") == 1)
	for _, value in { 0, 0.5, 0.999999 } do
		local picked = GalacticNews.Pick(function()
			return value
		end, "War")
		check("挑新聞不會連續重複：" .. tostring(value), picked ~= nil and picked.Id ~= "War")
	end
	local categories = {}
	for _, item in ItemDatabase.GetAll() do
		categories[item.Category] = true
		check(item.ID .. " 的分類有中文名稱", ItemDatabase.CategoryNames[item.Category] ~= nil)
	end
	for _, event in GalacticNews.Events do
		check(event.Id .. " 影響的分類存在", event.Category == nil or categories[event.Category] == true)
	end
end)

test("圖鑑與套裝", function()
	local codex = {}
	local isNew, isUpgrade = CodexSystem.Record(codex, "Item_001", "Normal")
	check("第一次收購是新物品", isNew == true and isUpgrade == false)
	isNew, isUpgrade = CodexSystem.Record(codex, "Item_001", "Normal")
	check("重複收購不算新", isNew == false and isUpgrade == false)
	isNew, isUpgrade = CodexSystem.Record(codex, "Item_001", "Shiny")
	check("閃亮版算升級", isNew == false and isUpgrade == true and codex.Item_001 == "Shiny")
	CodexSystem.Record(codex, "Item_001", "Normal")
	check("普通版不會蓋掉閃亮版", codex.Item_001 == "Shiny")
	check("舊存檔的 true 當成普通版", CodexSystem.VariantRank(true) == 0)
	check("圖鑑數量", CodexSystem.Count(codex) == 1 and CodexSystem.ShinyCount(codex) == 1)

	for _, set in CodexSystem.Sets do
		for _, itemId in set.Items or {} do
			check(set.Id .. " 裡的 " .. itemId .. " 存在", ItemDatabase.Get(itemId) ~= nil)
		end
		check(set.Id .. " 有條件", (set.Items ~= nil and #set.Items > 0) or (set.ShinyCount ~= nil and set.ShinyCount > 0))
	end

	local data = { Codex = {} }
	local bonuses, completed = CodexSystem.CheckSetBonus(data)
	check("空圖鑑沒有加成", bonuses.SellBonus == 0 and bonuses.Patience == 0 and bonuses.Reputation == 0 and next(completed) == nil)
	for _, itemId in { "Item_009", "Item_011", "Item_018" } do
		CodexSystem.Record(data.Codex, itemId, "Normal")
	end
	bonuses, completed = CodexSystem.CheckSetBonus(data)
	check("集齊美食套裝得到耐心加成", completed.Foodie == true and bonuses.Patience == 10)
	local emptyBonuses = CodexSystem.CheckSetBonus(nil)
	check("壞資料不會出錯", emptyBonuses.SellBonus == 0)
end)

test("成就", function()
	local stats = { DealsMade = 1, ItemsSold = 0, TotalProfit = 0 }
	local newly = Achievements.CheckNew({}, stats)
	check("第一筆收購達成開張大吉", #newly == 1 and newly[1].Id == "FirstDeal")
	check("領過的成就不會再發", #Achievements.CheckNew({ FirstDeal = true }, stats) == 0)
	local ids = {}
	for _, def in Achievements.List do
		check(def.Id .. " 沒有重複", ids[def.Id] == nil)
		ids[def.Id] = true
		check(def.Id .. " 的目標與獎勵是正數", def.Goal > 0 and def.Reward > 0)
	end
	check("進度不會超過目標", Achievements.GetProgress(Achievements.List[1], { DealsMade = 99 }) == Achievements.List[1].Goal)
end)

test("稱號與每日獎勵", function()
	local rank, nextRank = Progression.GetRank(0)
	check("名聲 0 是第一個稱號", rank == Config.Ranks[1] and nextRank == Config.Ranks[2])
	rank, nextRank = Progression.GetRank(99999)
	check("名聲很高是最後一個稱號", rank == Config.Ranks[#Config.Ranks] and nextRank == nil)

	local daily = { LastDay = 0, Streak = 0 }
	check("新玩家可以領", Progression.ClaimDaily(daily, 100) == Config.DailyRewards[1] and daily.Streak == 1)
	check("同一天不能再領", Progression.ClaimDaily(daily, 100) == nil)
	check("隔天連續登入", Progression.ClaimDaily(daily, 101) == Config.DailyRewards[2] and daily.Streak == 2)
	check("中斷後重新計算", Progression.ClaimDaily(daily, 105) == Config.DailyRewards[1] and daily.Streak == 1)
	daily = { LastDay = 200, Streak = 50 }
	check("連續很多天維持最高獎勵", Progression.ClaimDaily(daily, 201) == Config.DailyRewards[#Config.DailyRewards])
end)

test("兌換碼設定", function()
	for code, reward in Config.Codes do
		check("兌換碼 " .. code .. " 是大寫英數字", string.upper(code) == code and string.match(code, "^%w+$") ~= nil)
		check("兌換碼 " .. code .. " 的獎勵是正數", type(reward) == "number" and reward > 0)
	end
end)

test("職業", function()
	check("有三個職業", #Jobs.List == 3)
	for _, id in { "Pawnbroker", "Merchant", "Guard" } do
		check("職業存在：" .. id, Jobs.IsValid(id) and Jobs.Get(id) ~= nil)
	end
	check("不存在的職業", not Jobs.IsValid("Ninja") and not Jobs.IsValid(nil) and Jobs.Get(nil) == nil)
end)

test("貨物與收購商", function()
	for pointId, point in Cargo.Points do
		for _, drop in point.Drops do
			check(pointId .. " 掉落的資源存在：" .. drop.Resource, Cargo.Resources[drop.Resource] ~= nil)
		end
		local relic = Cargo.RollDrop(pointId, function()
			return 0
		end)
		check(pointId .. " 隨機值 0 會挖到遺物", relic ~= nil and relic.Kind == "Relic")
		local resource = Cargo.RollDrop(pointId, function()
			return 0.999
		end)
		check(pointId .. " 隨機值很大會拿到資源", resource ~= nil and resource.Kind == "Resource" and Cargo.Resources[resource.Resource] ~= nil)
	end
	check("不存在的採集點", Cargo.RollDrop("Moon", math.random) == nil)

	local ore = { Kind = "Resource", Resource = "StarOre", Stolen = false }
	local stolenOre = { Kind = "Resource", Resource = "StarOre", Stolen = true }
	check("貿易站收星礦", Cargo.Quote("TradingPost", ore) == math.floor(40 * 1.25 + 0.5))
	check("研究院收星礦比較便宜", Cargo.Quote("Institute", ore) < Cargo.Quote("TradingPost", ore))
	check("行情倍率有效", Cargo.Quote("TradingPost", ore, 2) == math.floor(40 * 1.25 * 2 + 0.5))
	check("貿易站不收贓物", Cargo.Quote("TradingPost", stolenOre) == nil)
	check("黑市收贓物", (Cargo.Quote("BlackMarket", stolenOre) or 0) > 0)
	check("黑市比較便宜", Cargo.Quote("BlackMarket", ore) < Cargo.Quote("TradingPost", ore))
	check("不存在的收購商", Cargo.Quote("Nope", ore) == nil)
	local relic = { Kind = "Relic", Item = { ItemId = "Item_002", IsFake = false, Variant = "Normal" }, Stolen = false }
	check("遺物報價 = 基礎價值 3 成", Cargo.Quote("TradingPost", relic) == math.floor(300 * 0.3))
	check("沒有物品的遺物不能賣", Cargo.Quote("TradingPost", { Kind = "Relic", Stolen = false }) == nil)
	check("贓物名稱有標記", string.find(Cargo.DisplayName(stolenOre), "贓物", 1, true) ~= nil)
	check("遺物名稱有標記", string.find(Cargo.DisplayName(relic), "遺物", 1, true) ~= nil)

	-- 每種資源在至少一個正當收購商的價格比黑市好
	for resourceId in Cargo.Resources do
		local item = { Kind = "Resource", Resource = resourceId, Stolen = false }
		local best = math.max(Cargo.Quote("TradingPost", item), Cargo.Quote("Institute", item))
		check(resourceId .. " 正當賣比黑市好", best > Cargo.Quote("BlackMarket", item))
	end
end)

test("犯罪規則", function()
	local base = {
		RobberJob = "Merchant",
		RobberJailed = false,
		RobberOnCooldown = false,
		RobberFreeSlots = 6,
		VictimJailed = false,
		VictimCargo = 4,
		VictimInSafeZone = false,
		VictimNewbie = false,
		VictimEscorted = false,
		RobberInSafeZone = false,
		Distance = 5,
		SameActor = false,
	}
	local function with(changes)
		local ctx = table.clone(base)
		for key, value in changes do
			ctx[key] = value
		end
		return ctx
	end
	check("一般情況可以搶", Crime.CanRob(base) == true)
	check("保鑣不能搶", Crime.CanRob(with({ RobberJob = "Guard" })) == false)
	check("不能搶自己", Crime.CanRob(with({ SameActor = true })) == false)
	check("坐牢不能搶", Crime.CanRob(with({ RobberJailed = true })) == false)
	check("冷卻中不能搶", Crime.CanRob(with({ RobberOnCooldown = true })) == false)
	check("太遠不能搶", Crime.CanRob(with({ Distance = 999 })) == false)
	check("安全區不能搶", Crime.CanRob(with({ VictimInSafeZone = true })) == false)
	check("自己在安全區也不能搶", Crime.CanRob(with({ RobberInSafeZone = true })) == false)
	check("新手保護", Crime.CanRob(with({ VictimNewbie = true })) == false)
	check("保鑣護送", Crime.CanRob(with({ VictimEscorted = true })) == false)
	check("對方沒貨", Crime.CanRob(with({ VictimCargo = 0 })) == false)
	check("自己沒空位", Crime.CanRob(with({ RobberFreeSlots = 0 })) == false)
	check("搶走一半（無條件進位）", Crime.RobCount(5, 10) == 3)
	check("至少搶 1 件", Crime.RobCount(1, 10) == 1)
	check("不超過自己的空位", Crime.RobCount(6, 2) == 2)
	check("通緝有上限", Crime.AddWanted(Config.Town.MaxWanted, 3) == Config.Town.MaxWanted)
	check("通緝會隨時間下降", Crime.DecayWanted(3, Config.Town.WantedDecay * 2 + 1) == 1)
	check("通緝不會變負的", Crime.DecayWanted(1, 99999) == 0)
	check("坐牢時間隨通緝增加", Crime.JailSeconds(3) == 3 * Config.Town.JailPerLevel)
	check("賞金隨通緝增加", Crime.Bounty(2) == 2 * Config.Town.BountyPerLevel)
	check("在方塊裡", Crime.InBox(Vector3.new(1, 1, 1), Vector3.zero, Vector3.new(4, 4, 4)))
	check("不在方塊裡", not Crime.InBox(Vector3.new(3, 0, 0), Vector3.zero, Vector3.new(4, 4, 4)))
end)

if failed == 0 then
	print(string.format("[SelfTest] 全部通過（%d 項檢查）", passed))
else
	warn(string.format("[SelfTest] %d 項通過，%d 項失敗", passed, failed))
end
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="RBX00000021">
        <Properties>
          <string name="Name">TownBuilder</string>
          <ProtectedString name="Source"><![CDATA[-- 用程式碼蓋出「星塵鎮」：廣場、商店街（4 間當舖）、貿易站、研究院、黑市、監獄，
-- 以及城外的隕石礦場、飛碟墜毀點和連接的道路。
--
-- 所有可以互動的東西都是 ProximityPrompt，掛著 Action 屬性，由 Main 的路由交給各個 Service 處理。
-- 美術之後可以在 Studio 裡把這些方塊換成正式模型，只要保留名稱和 Prompt 就好。

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local TownBuilder = {}

local town = nil -- Build() 之後的參考表

local COLORS = {
	Ground = Color3.fromRGB(64, 58, 82),
	Plaza = Color3.fromRGB(96, 98, 120),
	Road = Color3.fromRGB(45, 45, 55),
	Wall = Color3.fromRGB(46, 48, 72),
	Roof = Color3.fromRGB(32, 34, 52),
	Wood = Color3.fromRGB(110, 78, 58),
	Neon = Color3.fromRGB(70, 220, 255),
	Purple = Color3.fromRGB(140, 100, 255),
	Gold = Color3.fromRGB(255, 205, 90),
	Danger = Color3.fromRGB(255, 90, 90),
}

local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		p[key] = value
	end
	p.Parent = parent
	return p
end

local function light(parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Parent = parent
	return l
end

local function sign(parent, name, text, cframe, size, textColor)
	local board = part(parent, {
		Name = name,
		Size = size,
		CFrame = cframe,
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(20, 20, 34),
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.PixelsPerStud = 30
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.BuilderSansBold
	label.TextColor3 = textColor or COLORS.Neon
	label.Parent = gui
	return board, label
end

-- 頭上浮著的文字
local function floatingLabel(adornee, text, color, offsetY)
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(240, 46)
	billboard.StudsOffset = Vector3.new(0, offsetY or 4, 0)
	billboard.MaxDistance = 140
	billboard.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.BuilderSansBold
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = billboard
	billboard.Parent = adornee
	return billboard
end

local function prompt(parent, action, actionText, objectText, holdDuration, attributes)
	local p = Instance.new("ProximityPrompt")
	p.Name = action .. "Prompt"
	p.ActionText = actionText
	p.ObjectText = objectText or ""
	p.HoldDuration = holdDuration or 0
	p.MaxActivationDistance = 10
	p.RequiresLineOfSight = false
	p:SetAttribute("Action", action)
	if attributes then
		for key, value in attributes do
			p:SetAttribute(key, value)
		end
	end
	p.Parent = parent
	CollectionService:AddTag(p, "TownPrompt")
	return p
end

local function safeZone(folder, name, center, size)
	local zone = part(folder, {
		Name = name,
		Size = size,
		Position = center,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	return zone
end

-- 簡單的屋子：地板、三面牆、屋頂，正面（朝 facing 方向）開口
local function building(parent, name, center, size, facing, wallColor)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	local w, h, d = size.X, size.Y, size.Z
	local base = CFrame.lookAt(center, center + facing)
	part(model, { Name = "Floor", Size = Vector3.new(w, 0.4, d), CFrame = base * CFrame.new(0, 0.2, 0), Material = Enum.Material.WoodPlanks, Color = COLORS.Wood })
	part(model, { Name = "Back", Size = Vector3.new(w, h, 1), CFrame = base * CFrame.new(0, h / 2, d / 2), Material = Enum.Material.Metal, Color = wallColor or COLORS.Wall })
	part(model, { Name = "Left", Size = Vector3.new(1, h, d), CFrame = base * CFrame.new(-w / 2, h / 2, 0), Material = Enum.Material.Metal, Color = wallColor or COLORS.Wall })
	part(model, { Name = "Right", Size = Vector3.new(1, h, d), CFrame = base * CFrame.new(w / 2, h / 2, 0), Material = Enum.Material.Metal, Color = wallColor or COLORS.Wall })
	part(model, { Name = "Roof", Size = Vector3.new(w + 2, 1, d + 2), CFrame = base * CFrame.new(0, h + 0.5, 0), Material = Enum.Material.Metal, Color = COLORS.Roof })
	part(model, { Name = "RoofGlow", Size = Vector3.new(w + 2, 0.3, 0.3), CFrame = base * CFrame.new(0, h, -d / 2 - 1), Material = Enum.Material.Neon, Color = COLORS.Purple, CanCollide = false })
	return model, base
end

local function lamp(parent, position, color)
	part(parent, { Name = "LampPost", Size = Vector3.new(0.6, 10, 0.6), Position = position + Vector3.new(0, 5, 0), Material = Enum.Material.Metal, Color = COLORS.Roof })
	local bulb = part(parent, { Name = "LampBulb", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Position = position + Vector3.new(0, 10.5, 0), Material = Enum.Material.Neon, Color = color or COLORS.Neon, CanCollide = false })
	light(bulb, bulb.Color, 28, 1.2)
end

local function road(parent, from, to, width)
	local mid = (from + to) / 2
	local length = (to - from).Magnitude
	part(parent, {
		Name = "Road",
		Size = Vector3.new(width, 0.2, length),
		CFrame = CFrame.lookAt(mid + Vector3.new(0, 0.1, 0), to + Vector3.new(0, 0.1, 0)),
		Material = Enum.Material.Asphalt,
		Color = COLORS.Road,
		CanQuery = false,
	})
	-- 路燈
	local steps = math.floor(length / 40)
	for i = 1, steps do
		local t = i / (steps + 1)
		local point = from:Lerp(to, t)
		local side = CFrame.lookAt(point, to).RightVector * (width / 2 + 2)
		lamp(parent, point + side, COLORS.Gold)
	end
end

local function npcFigure(parent, name, position, bodyColor, title)
	local model = Instance.new("Model")
	model.Name = name
	local body = part(model, { Name = "Body", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 2.4, 2.4), CFrame = CFrame.new(position + Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.SmoothPlastic, Color = bodyColor, CanCollide = true })
	part(model, { Name = "Head", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), Position = position + Vector3.new(0, 5, 0), Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(230, 220, 255) })
	part(model, { Name = "Visor", Size = Vector3.new(1.6, 0.5, 0.4), Position = position + Vector3.new(0, 5.2, 0.9), Material = Enum.Material.Neon, Color = COLORS.Neon, CanCollide = false })
	model.PrimaryPart = body
	model.Parent = parent
	floatingLabel(body, title, COLORS.Neon, 5)
	return model
end

local function buildShop(shopsFolder, safeFolder, index, x)
	local id = "Shop" .. index
	local center = Vector3.new(x, 0, -72)
	-- 店面開口朝 +Z（朝向廣場）
	local model, base = building(shopsFolder, id, center, Vector3.new(24, 14, 18), Vector3.new(0, 0, 1))
	model:SetAttribute("ShopId", id)
	model:SetAttribute("Owner", 0)

	-- 這裡的 base 是 lookAt(+Z)：local -Z = 世界 +Z（店門口）；local +Z = 世界 -Z（後牆）
	part(model, { Name = "Counter", Size = Vector3.new(12, 3.6, 2), CFrame = base * CFrame.new(0, 1.8, 2), Material = Enum.Material.Wood, Color = COLORS.Wood })
	local counterTop = part(model, { Name = "CounterTop", Size = Vector3.new(12.4, 0.3, 2.4), CFrame = base * CFrame.new(0, 3.75, 2), Material = Enum.Material.Glass, Color = Color3.fromRGB(150, 220, 255), Transparency = 0.3 })
	light(counterTop, Color3.fromRGB(190, 230, 255), 16, 1)

	-- 客人站在櫃檯前（靠門那側），面向店長（後牆方向）
	local spotPos = (base * CFrame.new(0, 3, -1.5)).Position
	part(model, {
		Name = "CustomerSpot",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.lookAt(spotPos, spotPos + Vector3.new(0, 0, -1)),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})

	-- 店長站的位置（櫃檯後面）
	local keeperPos = (base * CFrame.new(0, 3, 5)).Position
	part(model, { Name = "KeeperSpot", Size = Vector3.new(1, 1, 1), Position = keeperPos, Transparency = 1, CanCollide = false, CanQuery = false })

	-- 互動點：在櫃檯上
	local promptPart = part(model, { Name = "PromptPart", Size = Vector3.new(1, 1, 1), CFrame = base * CFrame.new(0, 4.5, 2), Transparency = 1, CanCollide = false, CanQuery = false })
	prompt(promptPart, "ShopCounter", "經營這間當舖", "當舖 " .. index, 0, { ShopId = id })
	local relicPrompt = prompt(promptPart, "SellRelic", "把遺物賣給這間當舖", "當舖 " .. index, 0, { ShopId = id })
	relicPrompt.KeyboardKeyCode = Enum.KeyCode.F
	relicPrompt.UIOffset = Vector2.new(0, 70)

	-- 招牌（在門口上方，朝外）
	local signCFrame = CFrame.lookAt((base * CFrame.new(0, 12, -9.6)).Position, (base * CFrame.new(0, 12, -20)).Position)
	local _, signLabel = sign(model, "Sign", "空店面（可經營）", signCFrame, Vector3.new(16, 2.6, 0.4), COLORS.Gold)
	model:SetAttribute("SignText", signLabel.Text)

	safeZone(safeFolder, id .. "Safe", Vector3.new(x, 8, -72), Vector3.new(24, 16, 18))

	return {
		Id = id,
		Index = index,
		Model = model,
		CustomerSpot = model.CustomerSpot,
		KeeperSpot = model.KeeperSpot,
		SignLabel = signLabel,
	}
end

function TownBuilder.Build()
	if town then
		return town
	end

	local existing = workspace:FindFirstChild("Town")
	if existing then
		existing:Destroy()
	end
	local old = workspace:FindFirstChild("Baseplate")
	if old then
		old:Destroy()
	end

	local root = Instance.new("Folder")
	root.Name = "Town"
	local safeFolder = Instance.new("Folder")
	safeFolder.Name = "SafeZones"
	safeFolder.Parent = root
	local shopsFolder = Instance.new("Folder")
	shopsFolder.Name = "Shops"
	shopsFolder.Parent = root
	local deco = Instance.new("Folder")
	deco.Name = "Decor"
	deco.Parent = root

	-- 地面
	part(root, { Name = "Ground", Size = Vector3.new(800, 2, 800), Position = Vector3.new(0, -1, 60), Material = Enum.Material.Slate, Color = COLORS.Ground })

	-- 中央廣場（安全區）--------------------------------------------------------
	part(root, { Name = "Plaza", Size = Vector3.new(96, 0.4, 96), Position = Vector3.new(0, 0.2, 0), Material = Enum.Material.Concrete, Color = COLORS.Plaza })
	safeZone(safeFolder, "PlazaSafe", Vector3.new(0, 12, 0), Vector3.new(96, 30, 96))
	part(deco, { Name = "SafeLineN", Size = Vector3.new(96, 0.3, 0.6), Position = Vector3.new(0, 0.45, -48), Material = Enum.Material.Neon, Color = Color3.fromRGB(110, 225, 140), CanCollide = false })
	part(deco, { Name = "SafeLineS", Size = Vector3.new(96, 0.3, 0.6), Position = Vector3.new(0, 0.45, 48), Material = Enum.Material.Neon, Color = Color3.fromRGB(110, 225, 140), CanCollide = false })
	part(deco, { Name = "SafeLineW", Size = Vector3.new(0.6, 0.3, 96), Position = Vector3.new(-48, 0.45, 0), Material = Enum.Material.Neon, Color = Color3.fromRGB(110, 225, 140), CanCollide = false })
	part(deco, { Name = "SafeLineE", Size = Vector3.new(0.6, 0.3, 96), Position = Vector3.new(48, 0.45, 0), Material = Enum.Material.Neon, Color = Color3.fromRGB(110, 225, 140), CanCollide = false })

	-- 噴泉
	part(deco, { Name = "Fountain", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 16, 16), CFrame = CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Marble, Color = Color3.fromRGB(200, 200, 220) })
	local core = part(deco, { Name = "FountainCore", Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4), Position = Vector3.new(0, 5, 0), Material = Enum.Material.Neon, Color = COLORS.Neon, CanCollide = false })
	light(core, COLORS.Neon, 40, 2)
	floatingLabel(core, "星塵鎮", COLORS.Neon, 5)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlazaSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 0.4, 12)
	spawn.CFrame = CFrame.new(0, 0.6, 22)
	spawn.Material = Enum.Material.Neon
	spawn.Color = COLORS.Purple
	spawn.Transparency = 0.5
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = root

	-- 職業公告板
	local boardCFrame = CFrame.lookAt(Vector3.new(-18, 4.5, 10), Vector3.new(-18, 4.5, 30))
	local board = sign(root, "JobBoard", "職業公告板", boardCFrame, Vector3.new(10, 5, 0.6), COLORS.Gold)
	part(deco, { Name = "JobBoardLegL", Size = Vector3.new(0.5, 4, 0.5), Position = Vector3.new(-22.5, 2, 10), Material = Enum.Material.Metal, Color = COLORS.Roof })
	part(deco, { Name = "JobBoardLegR", Size = Vector3.new(0.5, 4, 0.5), Position = Vector3.new(-13.5, 2, 10), Material = Enum.Material.Metal, Color = COLORS.Roof })
	prompt(board, "JobBoard", "選擇職業", "職業公告板", 0)

	-- 城鎮 NPC 警衛（通緝犯靠近會被抓）
	local npcGuard = npcFigure(root, "NpcGuard", Vector3.new(18, 0, 8), Color3.fromRGB(70, 110, 200), "城鎮警衛（通緝犯別靠近）")

	for _, corner in { Vector3.new(-44, 0, -44), Vector3.new(44, 0, -44), Vector3.new(-44, 0, 44), Vector3.new(44, 0, 44) } do
		lamp(deco, corner, COLORS.Neon)
	end

	-- 商店街：4 間當舖 ------------------------------------------------------------
	part(root, { Name = "ShopStreet", Size = Vector3.new(120, 0.3, 14), Position = Vector3.new(0, 0.15, -56), Material = Enum.Material.Cobblestone, Color = Color3.fromRGB(80, 80, 96) })
	local shops = {}
	for i, x in { -45, -15, 15, 45 } do
		shops["Shop" .. i] = buildShop(shopsFolder, safeFolder, i, x)
	end

	-- 貿易站（西）與研究院（東）-----------------------------------------------
	local _, tradeBase = building(root, "TradingPost", Vector3.new(-70, 0, 12), Vector3.new(20, 12, 16), Vector3.new(1, 0, 0), Color3.fromRGB(80, 60, 40))
	local tradeCounter = part(root, { Name = "TradeCounter", Size = Vector3.new(2, 3.6, 10), CFrame = tradeBase * CFrame.new(0, 1.8, 2), Material = Enum.Material.Wood, Color = COLORS.Wood })
	prompt(tradeCounter, "SellCargo", "賣出貨物", "貿易站", 0, { BuyerId = "TradingPost" })
	sign(root, "TradeSign", "貿易站", CFrame.lookAt((tradeBase * CFrame.new(0, 10, -8.6)).Position, (tradeBase * CFrame.new(0, 10, -20)).Position), Vector3.new(12, 2.4, 0.4), COLORS.Gold)
	npcFigure(root, "Trader", (tradeBase * CFrame.new(0, 0, 5)).Position, Color3.fromRGB(200, 150, 70), "貿易站老闆")
	safeZone(safeFolder, "TradeSafe", Vector3.new(-70, 8, 12), Vector3.new(20, 16, 22))

	local _, instBase = building(root, "Institute", Vector3.new(70, 0, 12), Vector3.new(20, 12, 16), Vector3.new(-1, 0, 0), Color3.fromRGB(50, 70, 100))
	local dome = part(root, { Name = "Dome", Shape = Enum.PartType.Ball, Size = Vector3.new(14, 14, 14), Position = Vector3.new(70, 13, 12), Material = Enum.Material.Glass, Color = Color3.fromRGB(140, 220, 255), Transparency = 0.4, CanCollide = false })
	light(dome, COLORS.Neon, 30, 1)
	local instCounter = part(root, { Name = "InstituteCounter", Size = Vector3.new(2, 3.6, 10), CFrame = instBase * CFrame.new(0, 1.8, 2), Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(220, 230, 255) })
	prompt(instCounter, "SellCargo", "賣出貨物", "研究院", 0, { BuyerId = "Institute" })
	sign(root, "InstituteSign", "研究院", CFrame.lookAt((instBase * CFrame.new(0, 10, -8.6)).Position, (instBase * CFrame.new(0, 10, -20)).Position), Vector3.new(12, 2.4, 0.4), COLORS.Neon)
	npcFigure(root, "Researcher", (instBase * CFrame.new(0, 0, 5)).Position, Color3.fromRGB(230, 230, 240), "研究員")
	safeZone(safeFolder, "InstituteSafe", Vector3.new(70, 8, 12), Vector3.new(20, 16, 22))

	-- 黑市（商店街後面的暗巷，不是安全區）------------------------------------------
	local blackMarket = building(root, "BlackMarket", Vector3.new(0, 0, -105), Vector3.new(12, 8, 10), Vector3.new(0, 0, -1), Color3.fromRGB(30, 20, 30))
	local bmTable = part(blackMarket, { Name = "Table", Size = Vector3.new(6, 3, 2), Position = Vector3.new(0, 1.5, -103), Material = Enum.Material.Wood, Color = Color3.fromRGB(60, 40, 40) })
	prompt(bmTable, "SellCargo", "銷贓（什麼都收）", "黑市", 0, { BuyerId = "BlackMarket" })
	local bmLamp = part(blackMarket, { Name = "RedLamp", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), Position = Vector3.new(0, 7, -105), Material = Enum.Material.Neon, Color = COLORS.Danger, CanCollide = false })
	light(bmLamp, COLORS.Danger, 14, 1.5)
	npcFigure(root, "Fence", Vector3.new(0, 0, -101), Color3.fromRGB(40, 40, 40), "黑市商人")

	-- 監獄 ----------------------------------------------------------------------
	local jail = Instance.new("Model")
	jail.Name = "Jail"
	jail.Parent = root
	local jailCenter = Vector3.new(-75, 0, -100)
	part(jail, { Name = "Floor", Size = Vector3.new(18, 0.4, 18), Position = jailCenter + Vector3.new(0, 0.2, 0), Material = Enum.Material.Concrete, Color = Color3.fromRGB(70, 70, 80) })
	part(jail, { Name = "Roof", Size = Vector3.new(18, 1, 18), Position = jailCenter + Vector3.new(0, 14.5, 0), Material = Enum.Material.Metal, Color = COLORS.Roof })
	for _, offset in { Vector3.new(9, 7, 0), Vector3.new(-9, 7, 0), Vector3.new(0, 7, 9), Vector3.new(0, 7, -9) } do
		local size = (offset.X ~= 0) and Vector3.new(1, 14, 18) or Vector3.new(18, 14, 1)
		part(jail, { Name = "Wall", Size = size, Position = jailCenter + offset, Material = Enum.Material.Metal, Color = Color3.fromRGB(90, 90, 100) })
	end
	for i = -3, 3 do
		part(jail, { Name = "Bar", Size = Vector3.new(0.4, 10, 0.4), Position = jailCenter + Vector3.new(i * 2, 6, 9.8), Material = Enum.Material.Metal, Color = Color3.fromRGB(150, 150, 160), CanCollide = false })
	end
	local jailLight = part(jail, { Name = "JailLight", Size = Vector3.new(4, 0.3, 4), Position = jailCenter + Vector3.new(0, 13.8, 0), Material = Enum.Material.Neon, Color = COLORS.Danger, CanCollide = false })
	light(jailLight, COLORS.Danger, 20, 0.8)
	sign(root, "JailSign", "星塵鎮監獄", CFrame.lookAt(jailCenter + Vector3.new(0, 11, 10.2), jailCenter + Vector3.new(0, 11, 20)), Vector3.new(10, 2, 0.4), COLORS.Danger)
	local jailSpot = part(jail, { Name = "JailSpot", Size = Vector3.new(1, 1, 1), Position = jailCenter + Vector3.new(0, 3, 0), Transparency = 1, CanCollide = false, CanQuery = false })

	-- 城外：隕石礦場（南）與飛碟墜毀點（東南）------------------------------------
	road(root, Vector3.new(0, 0, 48), Vector3.new(0, 0, 220), 14)
	road(root, Vector3.new(48, 0, 30), Vector3.new(230, 0, 160), 14)

	local mine = Instance.new("Model")
	mine.Name = "Mine"
	mine.Parent = root
	local mineCenter = Vector3.new(0, 0, 250)
	part(mine, { Name = "Crater", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 70, 70), CFrame = CFrame.new(mineCenter + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Basalt, Color = Color3.fromRGB(70, 60, 60) })
	sign(root, "MineSign", "隕石礦場", CFrame.lookAt(Vector3.new(0, 7, 212), Vector3.new(0, 7, 180)), Vector3.new(14, 3, 0.4), COLORS.Gold)
	for i, offset in { Vector3.new(-16, 0, -6), Vector3.new(14, 0, -10), Vector3.new(-8, 0, 16), Vector3.new(18, 0, 12), Vector3.new(0, 0, 0) } do
		local rock = part(mine, {
			Name = "Ore" .. i,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(7, 7, 7),
			Position = mineCenter + offset + Vector3.new(0, 2.5, 0),
			Material = Enum.Material.Rock,
			Color = Color3.fromRGB(120, 125, 170),
		})
		local glow = part(mine, { Name = "OreGlow", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), Position = rock.Position + Vector3.new(0, 3, 0), Material = Enum.Material.Neon, Color = Color3.fromRGB(150, 160, 255), CanCollide = false })
		light(glow, glow.Color, 12, 1)
		local p = prompt(rock, "Collect", "採集", "隕石礦場", 1.2, { PointId = "Mine" })
		p.MaxActivationDistance = 12
	end

	local crash = Instance.new("Model")
	crash.Name = "CrashSite"
	crash.Parent = root
	local crashCenter = Vector3.new(255, 0, 175)
	part(crash, { Name = "Scorch", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 60, 60), CFrame = CFrame.new(crashCenter + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.CrackedLava, Color = Color3.fromRGB(60, 40, 40) })
	local saucer = part(crash, { Name = "Saucer", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 30, 30), CFrame = CFrame.new(crashCenter + Vector3.new(0, 4, 0)) * CFrame.Angles(math.rad(18), 0, math.rad(90)), Material = Enum.Material.Metal, Color = Color3.fromRGB(170, 180, 190) })
	part(crash, { Name = "SaucerDome", Shape = Enum.PartType.Ball, Size = Vector3.new(12, 12, 12), Position = crashCenter + Vector3.new(0, 8, -2), Material = Enum.Material.Glass, Color = Color3.fromRGB(120, 255, 170), Transparency = 0.4, CanCollide = false })
	light(saucer, Color3.fromRGB(120, 255, 170), 40, 1.5)
	sign(root, "CrashSign", "飛碟墜毀點", CFrame.lookAt(Vector3.new(222, 7, 150), Vector3.new(180, 7, 120)), Vector3.new(14, 3, 0.4), COLORS.Gold)
	for i, offset in { Vector3.new(-20, 0, 6), Vector3.new(18, 0, -14), Vector3.new(-6, 0, -22), Vector3.new(22, 0, 16), Vector3.new(-18, 0, 20) } do
		local debris = part(crash, {
			Name = "Debris" .. i,
			Size = Vector3.new(5, 3, 6),
			CFrame = CFrame.new(crashCenter + offset + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, math.rad(i * 37), math.rad(12)),
			Material = Enum.Material.DiamondPlate,
			Color = Color3.fromRGB(150, 160, 170),
		})
		local p = prompt(debris, "Collect", "搜刮", "飛碟墜毀點", 1.2, { PointId = "Crash" })
		p.MaxActivationDistance = 12
	end

	-- 燈光：太空小鎮的傍晚
	Lighting.ClockTime = 19.5
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(90, 80, 130)
	Lighting.OutdoorAmbient = Color3.fromRGB(100, 90, 140)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.6

	root.Parent = workspace

	local safeZones = {}
	for _, zone in safeFolder:GetChildren() do
		table.insert(safeZones, { Center = zone.Position, Size = zone.Size, Name = zone.Name })
	end

	town = {
		Root = root,
		Shops = shops,
		SafeZones = safeZones,
		JailSpot = jailSpot.Position,
		SpawnPosition = spawn.Position + Vector3.new(0, 3, 0),
		NpcGuard = npcGuard,
	}
	return town
end

function TownBuilder.Get()
	return town
end

return TownBuilder
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000022">
        <Properties>
          <string name="Name">TownService</string>
          <ProtectedString name="Source"><![CDATA[-- 多人小鎮的核心：職業、商人採集與賣貨、搶劫、通緝、逮捕、坐牢、護送。
--
-- 「角色」(actor) 通常是 Player；Studio 自動測試會用假的 table 當角色（設定 TestPosition）。
-- 會即時變動的資訊（職業、通緝、身上貨物、是否受保護）寫在 Player 的 Attribute 上，
-- 客戶端直接讀 Attribute 顯示，不用每秒推送整份狀態。

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cargo = require(Shared:WaitForChild("Cargo"))
local Config = require(Shared:WaitForChild("Config"))
local Crime = require(Shared:WaitForChild("Crime"))
local CustomerGenerator = require(Shared:WaitForChild("CustomerGenerator"))
local Jobs = require(Shared:WaitForChild("Jobs"))

local DataService = require(script.Parent:WaitForChild("DataService"))
local PromptRouter = require(script.Parent:WaitForChild("PromptRouter"))
local TownBuilder = require(script.Parent:WaitForChild("TownBuilder"))

local TownService = {}

local TOWN = Config.Town
local sessions = {} -- [actor] = session
local rng = Random.new()
local demand = { StarOre = 1, AlienParts = 1, EnergyCrystal = 1 }
local demandEndsAt = 0

-- 其他 Service 注入的函式
local hooks = {
	PushState = function(_actor) end,
	Notify = function(_actor, _text, _ok) end,
	HasPass = function(_actor, _passName)
		return false
	end,
	OnJobChanged = function(_actor, _oldJob, _newJob) end,
}

local function now()
	return os.clock()
end

local function rand()
	return rng:NextNumber()
end

local function isPlayer(actor)
	return typeof(actor) == "Instance" and actor:IsA("Player")
end

local function nameOf(actor)
	if isPlayer(actor) then
		return actor.DisplayName
	end
	return tostring(actor.Name or "某人")
end

function TownService.Configure(newHooks)
	for key, fn in newHooks do
		hooks[key] = fn
	end
end

function TownService.GetSession(actor)
	return sessions[actor]
end

function TownService.AddActor(actor, options)
	local session = {
		Job = nil,
		Cargo = {},
		Wanted = 0,
		LastCrimeAt = 0,
		JailedUntil = 0,
		RobCooldownUntil = 0,
		JoinedAt = now(),
		BodyguardReadyAt = 0,
		LastEscortPay = 0,
		TestPosition = nil,
		LastAttributes = {},
	}
	if options then
		for key, value in options do
			session[key] = value
		end
	end
	sessions[actor] = session
	return session
end

function TownService.RemoveActor(actor)
	sessions[actor] = nil
end

-- 位置 -------------------------------------------------------------------------

local function rootPart(actor)
	if not isPlayer(actor) then
		return nil
	end
	local character = actor.Character
	return character and character:FindFirstChild("HumanoidRootPart") or nil
end

function TownService.GetPosition(actor)
	local session = sessions[actor]
	if session and session.TestPosition then
		return session.TestPosition
	end
	local root = rootPart(actor)
	return root and root.Position or nil
end

function TownService.Teleport(actor, position)
	local session = sessions[actor]
	if session and session.TestPosition then
		session.TestPosition = position
		return
	end
	local root = rootPart(actor)
	if root then
		root.CFrame = CFrame.new(position)
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

function TownService.InSafeZone(position)
	if not position then
		return false
	end
	local town = TownBuilder.Get()
	if not town then
		return false
	end
	for _, zone in town.SafeZones do
		if Crime.InBox(position, zone.Center, zone.Size) then
			return true
		end
	end
	return false
end

local function distance(a, b)
	local pa, pb = TownService.GetPosition(a), TownService.GetPosition(b)
	if not pa or not pb then
		return math.huge
	end
	return (pa - pb).Magnitude
end

-- 狀態查詢 ---------------------------------------------------------------------

function TownService.GetJob(actor)
	local session = sessions[actor]
	return session and session.Job or nil
end

function TownService.IsJailed(actor)
	local session = sessions[actor]
	return session ~= nil and session.JailedUntil > now()
end

function TownService.IsNewbie(actor)
	local session = sessions[actor]
	return session ~= nil and (now() - session.JoinedAt) < TOWN.NewbieProtection
end

function TownService.Capacity(actor)
	local capacity = TOWN.CargoCapacity
	if hooks.HasPass(actor, "BigBackpack") then
		capacity += TOWN.BigBackpackBonus
	end
	return capacity
end

function TownService.CargoCount(actor)
	local session = sessions[actor]
	return session and #session.Cargo or 0
end

function TownService.RelicCount(actor)
	local session = sessions[actor]
	local count = 0
	if session then
		for _, item in session.Cargo do
			if item.Kind == "Relic" then
				count += 1
			end
		end
	end
	return count
end

-- 有沒有保鑣在旁邊護送
function TownService.IsEscorted(actor)
	for other, otherSession in sessions do
		if other ~= actor and otherSession.Job == "Guard" and otherSession.JailedUntil <= now() then
			if distance(actor, other) <= TOWN.EscortRange then
				return true
			end
		end
	end
	return false
end

-- 不能被搶的原因（nil = 可以被搶）
function TownService.ProtectionReason(actor)
	if TownService.IsJailed(actor) then
		return "坐牢中"
	end
	if TownService.InSafeZone(TownService.GetPosition(actor)) then
		return "安全區"
	end
	if TownService.IsNewbie(actor) then
		local session = sessions[actor]
		local left = math.ceil(TOWN.NewbieProtection - (now() - session.JoinedAt))
		return string.format("新手保護（剩 %d 分鐘）", math.max(1, math.ceil(left / 60)))
	end
	if TownService.IsEscorted(actor) then
		return "保鑣護送中"
	end
	return nil
end

-- 給客戶端的狀態 -----------------------------------------------------------------

function TownService.GetPublicState(actor)
	local session = sessions[actor]
	if not session then
		return nil
	end
	local data = DataService.Get(actor)
	local job = Jobs.Get(session.Job)

	local cargoList = {}
	for _, item in session.Cargo do
		table.insert(cargoList, { Name = Cargo.DisplayName(item), Stolen = item.Stolen, Kind = item.Kind })
	end

	-- 各收購商目前的價格表
	local prices = {}
	for _, buyerId in { "TradingPost", "Institute", "BlackMarket" } do
		local buyer = Cargo.Buyers[buyerId]
		local row = { Buyer = buyer.Name, Prices = {} }
		for _, resourceId in { "StarOre", "AlienParts", "EnergyCrystal" } do
			local quote = Cargo.Quote(buyerId, { Kind = "Resource", Resource = resourceId, Stolen = false }, demand[resourceId])
			table.insert(row.Prices, { Name = Cargo.ResourceName(resourceId), Price = quote or 0 })
		end
		table.insert(prices, row)
	end

	local jobList = {}
	for _, def in Jobs.List do
		table.insert(jobList, { Id = def.Id, Name = def.Name, Icon = def.Icon, Summary = def.Summary, Color = def.Color })
	end

	return {
		Job = session.Job,
		JobName = job and job.Name or nil,
		JobIcon = job and job.Icon or nil,
		JobSteps = job and job.Steps or {},
		JobSummary = job and job.Summary or nil,
		Jobs = jobList,
		Cargo = cargoList,
		Capacity = TownService.Capacity(actor),
		Wanted = session.Wanted,
		JailSecondsLeft = math.max(0, math.ceil(session.JailedUntil - now())),
		Insurance = data and data.Insurance or 0,
		InsurancePrice = TOWN.Insurance.Price,
		InsuranceMax = TOWN.Insurance.MaxStack,
		Prices = prices,
	}
end

-- 頭上的名牌 & Attribute -----------------------------------------------------------

local function updateTag(actor, session)
	if not isPlayer(actor) then
		return
	end
	local character = actor.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local tag = head:FindFirstChild("TownTag")
	if not tag then
		tag = Instance.new("BillboardGui")
		tag.Name = "TownTag"
		tag.Size = UDim2.fromOffset(200, 44)
		tag.StudsOffset = Vector3.new(0, 3.2, 0)
		tag.MaxDistance = 120
		local label = Instance.new("TextLabel")
		label.Name = "Label"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextScaled = true
		label.Font = Enum.Font.BuilderSansBold
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0.3
		label.Parent = tag
		tag.Parent = head
	end
	local job = Jobs.Get(session.Job)
	local text = job and (job.Icon .. " " .. job.Name) or "（還沒選職業）"
	if session.Wanted > 0 then
		text ..= "\n" .. string.rep("⭐", session.Wanted)
	elseif #session.Cargo > 0 then
		text ..= "\n📦×" .. #session.Cargo
	end
	if TownService.IsJailed(actor) then
		text = "⛓ 坐牢中"
	end
	tag.Label.Text = text
	tag.Label.TextColor3 = session.Wanted > 0 and Color3.fromRGB(255, 120, 120) or Color3.new(1, 1, 1)
end

function TownService.RefreshAttributes(actor)
	local session = sessions[actor]
	if not session or not isPlayer(actor) then
		return
	end
	local protection = TownService.ProtectionReason(actor)
	local values = {
		Job = session.Job or "",
		Wanted = session.Wanted,
		Cargo = #session.Cargo,
		Relics = TownService.RelicCount(actor),
		Capacity = TownService.Capacity(actor),
		Jailed = TownService.IsJailed(actor),
		JailedUntilUnix = TownService.IsJailed(actor) and (os.time() + math.ceil(session.JailedUntil - now())) or 0,
		Protected = protection ~= nil,
		Protection = protection or "",
	}
	local changed = false
	for key, value in values do
		if session.LastAttributes[key] ~= value then
			session.LastAttributes[key] = value
			actor:SetAttribute(key, value)
			changed = true
		end
	end
	if changed then
		updateTag(actor, session)
	end
end

-- 職業 -------------------------------------------------------------------------

function TownService.SetJob(actor, jobId)
	local session = sessions[actor]
	if not session then
		return false, "資料讀取中。"
	end
	if not Jobs.IsValid(jobId) then
		return false, "沒有這個職業。"
	end
	if TownService.IsJailed(actor) then
		return false, "坐牢中不能換職業。"
	end
	if session.Job == jobId then
		return false, "你已經是這個職業了。"
	end
	if jobId == "Guard" and session.Wanted > 0 then
		return false, "通緝犯不能當保鑣！等通緝消失再來。"
	end
	local oldJob = session.Job
	session.Job = jobId
	local data = DataService.Get(actor)
	if data then
		data.LastJob = jobId
	end
	hooks.OnJobChanged(actor, oldJob, jobId)
	TownService.RefreshAttributes(actor)
	local job = Jobs.Get(jobId)
	return true, string.format("你現在是「%s %s」！%s", job.Icon, job.Name, job.Summary)
end

-- 採集與賣貨 ---------------------------------------------------------------------

local function promptPosition(prompt)
	local parent = prompt and prompt.Parent
	if parent and typeof(parent) == "Instance" and parent:IsA("BasePart") then
		return parent.Position
	end
	if type(parent) == "table" and parent.Position then
		return parent.Position
	end
	return nil
end

local function nearPrompt(actor, prompt, range)
	local at = promptPosition(prompt)
	local pos = TownService.GetPosition(actor)
	if not at or not pos then
		return false
	end
	return (at - pos).Magnitude <= range
end

function TownService.Collect(actor, pointId, prompt)
	local session = sessions[actor]
	if not session then
		return false, "資料讀取中。"
	end
	if session.Job ~= "Merchant" then
		return false, "只有商人能採集。到廣場的職業公告板可以換職業。"
	end
	if TownService.IsJailed(actor) then
		return false, "坐牢中。"
	end
	local point = Cargo.Points[pointId]
	if not point then
		return false, "這裡沒什麼好採的。"
	end
	if prompt and not nearPrompt(actor, prompt, 16) then
		return false, "離太遠了。"
	end
	if #session.Cargo >= TownService.Capacity(actor) then
		return false, "身上塞滿了！先運回城裡賣掉。"
	end
	local drop = Cargo.RollDrop(pointId, rand)
	if not drop then
		return false, "這裡沒什麼好採的。"
	end
	if drop.Kind == "Relic" then
		local data = DataService.Get(actor)
		local reputation = data and data.Reputation or 0
		drop.Item = CustomerGenerator.Generate(reputation, rand).Item
	end
	table.insert(session.Cargo, drop)
	TownService.RefreshAttributes(actor)
	local message = string.format("採集到：%s（%d / %d）", Cargo.DisplayName(drop), #session.Cargo, TownService.Capacity(actor))
	if drop.Kind == "Relic" then
		message = "✨ 挖到遺物！" .. Cargo.DisplayName(drop) .. "。拿去給玩家當舖鑑定，價格比較好。"
	end
	return true, message
end

-- 在收購商賣掉身上的貨物。
-- 一般收購商：先賣資源；身上只剩遺物時，才會把遺物也賣掉（遺物賣給玩家當舖價格比較好）。
function TownService.SellCargo(actor, buyerId, prompt)
	local session = sessions[actor]
	local data = DataService.Get(actor)
	if not session or not data then
		return false, "資料讀取中。"
	end
	local buyer = Cargo.Buyers[buyerId]
	if not buyer then
		return false, "這裡不收東西。"
	end
	if TownService.IsJailed(actor) then
		return false, "坐牢中。"
	end
	if prompt and not nearPrompt(actor, prompt, 16) then
		return false, "離太遠了。"
	end
	if #session.Cargo == 0 then
		return false, "你身上沒有貨物。"
	end

	local hasResource = false
	for _, item in session.Cargo do
		if item.Kind == "Resource" and Cargo.Quote(buyerId, item, demand[item.Resource]) then
			hasResource = true
		end
	end
	local sellRelics = buyer.AcceptsStolen or not hasResource

	local kept = {}
	local total, sold, refusedStolen = 0, 0, 0
	for _, item in session.Cargo do
		local quote = nil
		if item.Kind == "Resource" or sellRelics then
			quote = Cargo.Quote(buyerId, item, item.Resource and demand[item.Resource] or nil)
		end
		if quote then
			total += quote
			sold += 1
		else
			if item.Stolen and not buyer.AcceptsStolen then
				refusedStolen += 1
			end
			table.insert(kept, item)
		end
	end

	if sold == 0 then
		if refusedStolen > 0 then
			return false, buyer.Name .. "：「這些是贓物吧？我們不收！」（贓物只能拿去黑市）"
		end
		return false, buyer.Name .. "不收你身上的東西。"
	end

	session.Cargo = kept
	data.Credits += total
	if not buyer.AcceptsStolen then
		data.Stats.TotalProfit += total
	end
	TownService.RefreshAttributes(actor)

	local message = string.format("在%s賣了 %d 件貨物，拿到 %d 星幣！", buyer.Name, sold, total)
	local relicsLeft = TownService.RelicCount(actor)
	if relicsLeft > 0 and not buyer.AcceptsStolen then
		message ..= string.format("\n身上還有 %d 件遺物：賣給玩家當舖價格比較好，或再按一次賣給%s。", relicsLeft, buyer.Name)
	end
	if refusedStolen > 0 then
		message ..= string.format("\n%d 件贓物對方不收，只能去黑市。", refusedStolen)
	end
	return true, message
end

-- 從身上拿出第一件遺物（賣給玩家當舖用）
function TownService.TakeRelic(actor)
	local session = sessions[actor]
	if not session then
		return nil
	end
	for i, item in session.Cargo do
		if item.Kind == "Relic" then
			table.remove(session.Cargo, i)
			TownService.RefreshAttributes(actor)
			return item
		end
	end
	return nil
end

-- 遺物沒賣成：還給商人；商人不在或背包滿了，就自動以貿易站的價格賣掉
function TownService.ReturnRelic(actor, item)
	local session = sessions[actor]
	if session and #session.Cargo < TownService.Capacity(actor) then
		table.insert(session.Cargo, item)
		TownService.RefreshAttributes(actor)
		hooks.Notify(actor, "當舖沒收你的" .. Cargo.DisplayName(item) .. "，已經還給你了。", false)
		hooks.PushState(actor)
		return "returned"
	end
	local data = DataService.Get(actor)
	if data then
		local quote = Cargo.Quote("TradingPost", item) or Cargo.Quote("BlackMarket", item) or 0
		data.Credits += quote
		hooks.Notify(actor, string.format("當舖沒收你的遺物，你身上又滿了，自動賣給貿易站拿到 %d 星幣。", quote), true)
		hooks.PushState(actor)
		return "sold"
	end
	return "lost"
end

-- 犯罪 -------------------------------------------------------------------------

local function addWanted(actor, session, amount)
	session.Wanted = Crime.AddWanted(session.Wanted, amount)
	session.LastCrimeAt = now()
end

local function penalize(actor, amount)
	local data = DataService.Get(actor)
	if data then
		data.Reputation = math.max(0, data.Reputation - amount)
	end
end

function TownService.Rob(robber, victim)
	local rs, vs = sessions[robber], sessions[victim]
	if not rs or not vs then
		return false, "找不到對象。"
	end
	local t = now()
	local freeSlots = TownService.Capacity(robber) - #rs.Cargo
	local ok, reason = Crime.CanRob({
		RobberJob = rs.Job,
		RobberJailed = TownService.IsJailed(robber),
		RobberOnCooldown = rs.RobCooldownUntil > t,
		RobberFreeSlots = freeSlots,
		VictimJailed = TownService.IsJailed(victim),
		VictimCargo = #vs.Cargo,
		VictimInSafeZone = TownService.InSafeZone(TownService.GetPosition(victim)),
		RobberInSafeZone = TownService.InSafeZone(TownService.GetPosition(robber)),
		VictimNewbie = TownService.IsNewbie(victim),
		VictimEscorted = TownService.IsEscorted(victim),
		Distance = distance(robber, victim),
		SameActor = robber == victim,
	})
	if not ok then
		return false, reason
	end

	rs.RobCooldownUntil = t + TOWN.RobCooldown

	-- 機器人保鑣擋下
	if hooks.HasPass(victim, "BodyguardBot") and vs.BodyguardReadyAt <= t then
		vs.BodyguardReadyAt = t + TOWN.BodyguardCooldown
		addWanted(robber, rs, 1)
		penalize(robber, math.ceil(TOWN.RobReputationPenalty / 2))
		TownService.RefreshAttributes(robber)
		TownService.RefreshAttributes(victim)
		hooks.Notify(victim, "🤖 你的機器人保鑣擋下了" .. nameOf(robber) .. "的搶劫！", true)
		hooks.PushState(victim)
		return false, "🤖 對方的機器人保鑣把你擋開了！你被通緝了。"
	end

	local count = Crime.RobCount(#vs.Cargo, freeSlots)
	local lostValue = 0
	for _ = 1, count do
		local index = rng:NextInteger(1, #vs.Cargo)
		local item = table.remove(vs.Cargo, index)
		lostValue += Cargo.BaseValue(item)
		item.Stolen = true
		table.insert(rs.Cargo, item)
	end

	addWanted(robber, rs, 1)
	penalize(robber, TOWN.RobReputationPenalty)

	-- 被害人的保險
	local victimData = DataService.Get(victim)
	local victimMessage = string.format("😱 %s搶走了你 %d 件貨物！", nameOf(robber), count)
	if victimData and (victimData.Insurance or 0) > 0 then
		victimData.Insurance -= 1
		local refund = Crime.InsuranceRefund(lostValue)
		victimData.Credits += refund
		victimMessage ..= string.format(" 保險理賠 %d 星幣（剩 %d 次保險）。", refund, victimData.Insurance)
	end
	victimMessage ..= " 他已經被通緝了，快找保鑣！"

	TownService.RefreshAttributes(robber)
	TownService.RefreshAttributes(victim)
	hooks.Notify(victim, victimMessage, false)
	hooks.PushState(victim)

	return true, string.format("你搶到了 %d 件貨物（贓物）！名聲 -%d，通緝 %s。贓物只能去黑市賣。", count, TOWN.RobReputationPenalty, string.rep("⭐", rs.Wanted))
end

-- 關進監獄：沒收贓物、清除通緝
function TownService.Jail(actor, wantedLevel, reason)
	local session = sessions[actor]
	if not session then
		return 0
	end
	local seconds = Crime.JailSeconds(wantedLevel)
	session.JailedUntil = now() + seconds
	session.Wanted = 0
	local kept, confiscated = {}, 0
	for _, item in session.Cargo do
		if item.Stolen then
			confiscated += 1
		else
			table.insert(kept, item)
		end
	end
	session.Cargo = kept
	local town = TownBuilder.Get()
	if town then
		TownService.Teleport(actor, town.JailSpot)
	end
	TownService.RefreshAttributes(actor)
	local message = string.format("⛓ %s 你被關進監獄 %d 秒。", reason or "", seconds)
	if confiscated > 0 then
		message ..= string.format("沒收贓物 %d 件。", confiscated)
	end
	hooks.Notify(actor, message, false)
	hooks.PushState(actor)
	return seconds
end

function TownService.Arrest(guard, target)
	local gs, ts = sessions[guard], sessions[target]
	if not gs or not ts then
		return false, "找不到對象。"
	end
	if guard == target then
		return false, "不能抓自己。"
	end
	if gs.Job ~= "Guard" then
		return false, "只有保鑣能抓人。"
	end
	if TownService.IsJailed(guard) then
		return false, "你在坐牢。"
	end
	if TownService.IsJailed(target) then
		return false, "對方已經在坐牢了。"
	end
	if ts.Wanted <= 0 then
		return false, "對方沒有被通緝。"
	end
	if distance(guard, target) > TOWN.ArrestRange then
		return false, "離太遠了。"
	end
	local level = ts.Wanted
	local bounty = Crime.Bounty(level)
	TownService.Jail(target, level, nameOf(guard) .. "逮捕了你！")
	local data = DataService.Get(guard)
	if data then
		data.Credits += bounty
		data.Reputation += TOWN.ArrestReputationReward
	end
	TownService.RefreshAttributes(guard)
	return true, string.format("🛡️ 抓到通緝犯%s！賞金 %d 星幣，名聲 +%d。", nameOf(target), bounty, TOWN.ArrestReputationReward)
end

function TownService.BuyInsurance(actor)
	local data = DataService.Get(actor)
	if not data then
		return false, "資料讀取中。"
	end
	local insurance = TOWN.Insurance
	if (data.Insurance or 0) >= insurance.MaxStack then
		return false, string.format("保險最多只能存 %d 次。", insurance.MaxStack)
	end
	if data.Credits < insurance.Price then
		return false, "星幣不夠！"
	end
	data.Credits -= insurance.Price
	data.Insurance = (data.Insurance or 0) + 1
	return true, string.format("買了一份搶劫保險（現在有 %d 份）。被搶時會理賠損失的 %d%%。", data.Insurance, math.floor(insurance.Refund * 100))
end

-- 每秒更新 -----------------------------------------------------------------------

function TownService.Tick()
	local t = now()
	local town = TownBuilder.Get()

	-- 市場行情變動
	if t >= demandEndsAt then
		for resourceId in demand do
			demand[resourceId] = math.floor((0.8 + rand() * 0.5) * 100 + 0.5) / 100
		end
		demandEndsAt = t + Config.NewsInterval
	end

	local npcGuardPosition = nil
	if town and town.NpcGuard and town.NpcGuard.PrimaryPart then
		npcGuardPosition = town.NpcGuard.PrimaryPart.Position
	end

	for actor, session in sessions do
		-- 出獄
		if session.JailedUntil > 0 and session.JailedUntil <= t then
			session.JailedUntil = 0
			if town then
				TownService.Teleport(actor, town.SpawnPosition)
			end
			hooks.Notify(actor, "你出獄了。這次要當個好人喔！", true)
			hooks.PushState(actor)
		end

		-- 通緝等級慢慢下降
		if session.Wanted > 0 and t - session.LastCrimeAt >= TOWN.WantedDecay then
			session.Wanted -= 1
			session.LastCrimeAt = t
			if session.Wanted == 0 then
				hooks.Notify(actor, "風頭過了，你不再被通緝。", true)
			end
		end

		-- 通緝犯靠近廣場警衛就會被抓
		if npcGuardPosition and session.Wanted > 0 and not TownService.IsJailed(actor) then
			local pos = TownService.GetPosition(actor)
			if pos and (pos - npcGuardPosition).Magnitude <= TOWN.NpcGuardRange then
				TownService.Jail(actor, session.Wanted, "城鎮警衛認出你了！")
			end
		end

		-- 保鑣的護送費：旁邊有帶貨、不在安全區的商人
		if session.Job == "Guard" and not TownService.IsJailed(actor) and t - session.LastEscortPay >= TOWN.EscortPayInterval then
			for other, otherSession in sessions do
				if other ~= actor and #otherSession.Cargo > 0 and otherSession.Job == "Merchant" then
					local otherPos = TownService.GetPosition(other)
					if otherPos and not TownService.InSafeZone(otherPos) and distance(actor, other) <= TOWN.EscortRange then
						session.LastEscortPay = t
						local data = DataService.Get(actor)
						if data then
							data.Credits += TOWN.EscortPay
						end
						break
					end
				end
			end
		end

		TownService.RefreshAttributes(actor)
	end
end

-- 測試與外部使用 -------------------------------------------------------------------

function TownService.GetDemand()
	return demand
end

function TownService.AddCargoForTest(actor, item)
	local session = sessions[actor]
	if session then
		table.insert(session.Cargo, item)
	end
end

-- 啟動 -------------------------------------------------------------------------

local function addCharacterPrompts(player, character)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end
	local function makePrompt(action, text, hold)
		local p = Instance.new("ProximityPrompt")
		p.Name = action .. "Prompt"
		p.ActionText = text
		p.ObjectText = player.DisplayName
		p.HoldDuration = hold
		p.MaxActivationDistance = TOWN.RobRange
		p.RequiresLineOfSight = false
		p:SetAttribute("Action", action)
		p:SetAttribute("TargetUserId", player.UserId)
		p.Parent = root
		CollectionService:AddTag(p, "TownPrompt")
	end
	makePrompt("Rob", "搶劫", 1)
	makePrompt("Arrest", "逮捕", 0.5)
end

local function onPlayerAdded(player)
	TownService.AddActor(player)
	player.CharacterAdded:Connect(function(character)
		local session = sessions[player]
		if session then
			session.LastAttributes = {}
		end
		task.spawn(addCharacterPrompts, player, character)
		task.defer(function()
			local town = TownBuilder.Get()
			if town and TownService.IsJailed(player) then
				character:WaitForChild("HumanoidRootPart", 10)
				TownService.Teleport(player, town.JailSpot)
			end
			TownService.RefreshAttributes(player)
		end)
	end)
	if player.Character then
		task.spawn(addCharacterPrompts, player, player.Character)
	end
	TownService.RefreshAttributes(player)
end

local function targetFromPrompt(prompt)
	local userId = prompt:GetAttribute("TargetUserId")
	if type(userId) ~= "number" then
		return nil
	end
	return Players:GetPlayerByUserId(userId)
end

function TownService.Start()
	PromptRouter.Register("Collect", function(player, prompt)
		return TownService.Collect(player, prompt:GetAttribute("PointId"), prompt)
	end)
	PromptRouter.Register("SellCargo", function(player, prompt)
		return TownService.SellCargo(player, prompt:GetAttribute("BuyerId"), prompt)
	end)
	PromptRouter.Register("Rob", function(player, prompt)
		local target = targetFromPrompt(prompt)
		if not target then
			return false, "找不到對象。"
		end
		return TownService.Rob(player, target)
	end)
	PromptRouter.Register("Arrest", function(player, prompt)
		local target = targetFromPrompt(prompt)
		if not target then
			return false, "找不到對象。"
		end
		return TownService.Arrest(player, target)
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(TownService.Tick)
			if not ok then
				warn("[TownService] Tick 出錯：" .. tostring(err))
			end
		end
	end)
end

return TownService
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX00000023">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00000024">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX00000025">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00000026">
          <Properties>
            <string name="Name">CustomerModel</string>
            <ProtectedString name="Source"><![CDATA[-- 在櫃檯前生成客人的外星人模型（只在這位玩家的畫面上出現）。
-- 之後美術做好正式模型，可以換成從 ReplicatedStorage 複製 Model。

local RunService = game:GetService("RunService")

local CustomerModel = {}

local currentModel = nil
local currentId = nil
local bobConnection = nil

local function makePart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		p[key] = value
	end
	return p
end

local function clear()
	if bobConnection then
		bobConnection:Disconnect()
		bobConnection = nil
	end
	if currentModel then
		currentModel:Destroy()
		currentModel = nil
	end
	currentId = nil
end

-- 找店面的 CustomerSpot：多人版在 workspace.Town.Shops.<ShopId>，單人版在 workspace.PawnShop
local function getSpot(shopId)
	local town = workspace:FindFirstChild("Town")
	local shops = town and town:FindFirstChild("Shops")
	if shopId and shops then
		local shop = shops:FindFirstChild(shopId)
		return shop and shop:FindFirstChild("CustomerSpot") or nil
	end
	local single = workspace:FindFirstChild("PawnShop")
	return single and single:FindFirstChild("CustomerSpot") or nil
end

local function build(customer, spotCFrame)
	local c = customer.Color or { 0.6, 0.6, 0.6 }
	local bodyColor = Color3.new(c[1] or 0.6, c[2] or 0.6, c[3] or 0.6)

	local model = Instance.new("Model")
	model.Name = "Customer"

	-- 局部座標：-Z 是客人的正前方（面向玩家）
	local pieces = {
		{ Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.new(3.2, 3.2, 3.2), Offset = CFrame.new(0, -1, 0), Color = bodyColor, Material = Enum.Material.SmoothPlastic },
		{ Name = "Head", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), Offset = CFrame.new(0, 1.4, 0), Color = bodyColor, Material = Enum.Material.SmoothPlastic },
		{ Name = "EyeL", Shape = Enum.PartType.Ball, Size = Vector3.new(0.7, 0.7, 0.7), Offset = CFrame.new(-0.45, 1.6, -1.0), Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic },
		{ Name = "EyeR", Shape = Enum.PartType.Ball, Size = Vector3.new(0.7, 0.7, 0.7), Offset = CFrame.new(0.45, 1.6, -1.0), Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic },
		{ Name = "PupilL", Shape = Enum.PartType.Ball, Size = Vector3.new(0.35, 0.35, 0.35), Offset = CFrame.new(-0.45, 1.6, -1.3), Color = Color3.new(0.05, 0.05, 0.1), Material = Enum.Material.SmoothPlastic },
		{ Name = "PupilR", Shape = Enum.PartType.Ball, Size = Vector3.new(0.35, 0.35, 0.35), Offset = CFrame.new(0.45, 1.6, -1.3), Color = Color3.new(0.05, 0.05, 0.1), Material = Enum.Material.SmoothPlastic },
		{ Name = "Antenna", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 0.15, 0.15), Offset = CFrame.new(0, 3.1, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = bodyColor:Lerp(Color3.new(0, 0, 0), 0.3), Material = Enum.Material.SmoothPlastic },
		{ Name = "AntennaTip", Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5), Offset = CFrame.new(0, 3.9, 0), Color = Color3.fromRGB(255, 240, 120), Material = Enum.Material.Neon },
	}

	local offsets = {}
	for _, piece in pieces do
		local p = makePart({
			Name = piece.Name,
			Shape = piece.Shape,
			Size = piece.Size,
			Color = piece.Color,
			Material = piece.Material,
		})
		p.CFrame = spotCFrame * piece.Offset
		p.Parent = model
		offsets[p] = piece.Offset
		if piece.Name == "Body" then
			model.PrimaryPart = p
		end
	end

	-- 頭上的名牌
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(220, 50)
	billboard.StudsOffset = Vector3.new(0, 5, 0)
	billboard.AlwaysOnTop = true
	billboard.Adornee = model.PrimaryPart
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = customer.Name .. "（" .. customer.Species .. "）"
	label.TextScaled = true
	label.Font = Enum.Font.BuilderSansBold
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Parent = billboard
	billboard.Parent = model

	model.Parent = workspace

	-- 上下浮動
	local started = os.clock()
	bobConnection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - started
		local base = spotCFrame * CFrame.new(0, math.sin(t * 2) * 0.25, 0) * CFrame.Angles(0, math.sin(t * 0.8) * 0.15, 0)
		for p, offset in offsets do
			p.CFrame = base * offset
		end
	end)

	return model
end

local latestCustomer = nil
local latestShopId = nil
local waitingForSpot = false

-- customer 為 nil 時移除模型；shopId 是客人站在哪一間店
function CustomerModel.Show(customer, shopId)
	latestCustomer = customer
	latestShopId = shopId
	if customer == nil then
		clear()
		return
	end
	if customer.Id == currentId and currentModel then
		return
	end
	local spot = getSpot(shopId)
	if not spot then
		-- 場景可能還沒載入到這台裝置，等它出現再生成
		if not waitingForSpot then
			waitingForSpot = true
			task.spawn(function()
				local started = os.clock()
				while os.clock() - started < 30 and not getSpot(latestShopId) do
					task.wait(0.5)
				end
				waitingForSpot = false
				if latestCustomer and getSpot(latestShopId) then
					CustomerModel.Show(latestCustomer, latestShopId)
				end
			end)
		end
		return
	end
	clear()
	currentId = customer.Id
	currentModel = build(customer, spot.CFrame)
end

return CustomerModel
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX00000027">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source"><![CDATA[-- 客戶端進入點：建立介面、把按鈕接到伺服器、收到狀態就重畫。
-- 客戶端只負責顯示與送出請求，所有判定都在伺服器。

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local UI = require(script.Parent:WaitForChild("UI"))
local CustomerModel = require(script.Parent:WaitForChild("CustomerModel"))

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local shopAction = remotes:WaitForChild("ShopAction")
local stateChanged = remotes:WaitForChild("StateChanged")
local notifyEvent = remotes:WaitForChild("Notify")
local openJobPicker = remotes:WaitForChild("OpenJobPicker")

-- 聊天視窗預設在左上角，會蓋住左邊面板（簽到按鈕），移到下方中間
task.spawn(function()
	local ok, err = pcall(function()
		local TextChatService = game:GetService("TextChatService")
		local window = TextChatService:WaitForChild("ChatWindowConfiguration", 10)
		if window then
			window.HorizontalAlignment = Enum.HorizontalAlignment.Center
			window.VerticalAlignment = Enum.VerticalAlignment.Bottom
		end
	end)
	if not ok then
		warn("[Client] 移動聊天視窗失敗：" .. tostring(err))
	end
end)

local ui
local busy = false
local lastState = nil -- 最近一次收到的狀態

-- 鏡頭 -----------------------------------------------------------------------
-- 櫃檯營業時把鏡頭固定在店長身後、越過櫃檯看著客人；其他時候是一般第三人稱鏡頭。

local cameraBound = false

local function findSpot(shopId)
	local town = workspace:FindFirstChild("Town")
	local shops = town and town:FindFirstChild("Shops")
	local shop = shopId and shops and shops:FindFirstChild(shopId)
	if shop then
		return shop:FindFirstChild("CustomerSpot")
	end
	local single = workspace:FindFirstChild("PawnShop")
	return single and single:FindFirstChild("CustomerSpot") or nil
end

local function setCounterCamera(shopId)
	local spot = shopId and findSpot(shopId) or nil
	if Config.FixedCamera and not spot then
		spot = findSpot(nil)
	end
	if spot then
		-- CustomerSpot 的正前方（LookVector）朝向店長
		local eye = (spot.CFrame * CFrame.new(0, 3.5, -5)).Position
		local target = (spot.CFrame * CFrame.new(0, 0.5, 0)).Position
		local cameraCFrame = CFrame.lookAt(eye, target)
		if cameraBound then
			RunService:UnbindFromRenderStep("ShopCamera")
		end
		cameraBound = true
		RunService:BindToRenderStep("ShopCamera", Enum.RenderPriority.Camera.Value + 1, function()
			local camera = workspace.CurrentCamera
			if camera then
				camera.CameraType = Enum.CameraType.Scriptable
				camera.CFrame = cameraCFrame
			end
		end)
	elseif cameraBound then
		cameraBound = false
		RunService:UnbindFromRenderStep("ShopCamera")
		local camera = workspace.CurrentCamera
		if camera then
			camera.CameraType = Enum.CameraType.Custom
		end
	end
end

-- 狀態 -----------------------------------------------------------------------

local function applyState(state)
	if not state then
		return
	end
	lastState = state
	ui.Render(state)
	local atCounter = state.Shop ~= nil and state.Shop.CounterOpen
	CustomerModel.Show(atCounter and state.Customer or nil, state.Shop and state.Shop.Id or nil)
	setCounterCamera(atCounter and state.Shop.Id or nil)
end

local function request(action, payload)
	if busy then
		return
	end
	busy = true
	local ok, response = pcall(function()
		return shopAction:InvokeServer(action, payload)
	end)
	busy = false
	if not ok or type(response) ~= "table" then
		ui.Toast("連線出錯，請再試一次。", false)
		return
	end
	if response.Message then
		ui.Toast(response.Message, response.Ok)
	end
	applyState(response.State)
end

ui = UI.Create(playerGui, {
	Next = function()
		request("NextCustomer")
	end,
	Inspect = function(toolId)
		request("Inspect", { ToolId = toolId })
	end,
	Offer = function(amount)
		request("Offer", { Amount = amount })
	end,
	Reject = function()
		request("Reject")
	end,
	Sell = function(uid)
		request("SellItem", { Uid = uid })
	end,
	BuyTool = function(toolId)
		request("BuyTool", { ToolId = toolId })
	end,
	ClaimDaily = function()
		request("ClaimDaily")
	end,
	RedeemCode = function(code)
		request("RedeemCode", { Code = code })
	end,
	ChooseJob = function(jobId)
		request("ChooseJob", { JobId = jobId })
	end,
	CloseCounter = function()
		request("CloseCounter")
	end,
	BuyInsurance = function()
		request("BuyInsurance")
	end,
})

stateChanged.OnClientEvent:Connect(applyState)
notifyEvent.OnClientEvent:Connect(function(text, ok)
	ui.Toast(text, ok)
end)
openJobPicker.OnClientEvent:Connect(function()
	ui.ShowJobPicker()
end)

-- 互動提示：依自己的職業與對方狀態，只顯示用得到的 Prompt（伺服器還是會再檢查一次）---

local function promptShop(prompt)
	local shopId = prompt:GetAttribute("ShopId")
	local town = workspace:FindFirstChild("Town")
	local shops = town and town:FindFirstChild("Shops")
	return shopId and shops and shops:FindFirstChild(shopId) or nil
end

local function refreshPrompts()
	local myJob = player:GetAttribute("Job")
	local jailed = player:GetAttribute("Jailed") == true
	for _, prompt in CollectionService:GetTagged("TownPrompt") do
		if prompt:IsA("ProximityPrompt") then
			local action = prompt:GetAttribute("Action")
			local enabled = not jailed
			if action == "Collect" then
				-- 不是商人也顯示提示，按下去伺服器會說明要換職業，避免新手以為這裡什麼都沒有
				local original = prompt:GetAttribute("OriginalActionText")
				if not original then
					original = prompt.ActionText
					prompt:SetAttribute("OriginalActionText", original)
				end
				local text = myJob == "Merchant" and original or "只有商人能採集"
				if prompt.ActionText ~= text then
					prompt.ActionText = text
				end
				local hold = myJob == "Merchant" and 1.2 or 0
				if prompt.HoldDuration ~= hold then
					prompt.HoldDuration = hold
				end
			elseif action == "Rob" or action == "Arrest" then
				local target = Players:GetPlayerByUserId(prompt:GetAttribute("TargetUserId") or 0)
				if not target or target == player then
					enabled = false
				elseif action == "Rob" then
					enabled = enabled and myJob ~= "Guard" and (target:GetAttribute("Cargo") or 0) > 0 and target:GetAttribute("Protected") ~= true
				else
					enabled = enabled and myJob == "Guard" and (target:GetAttribute("Wanted") or 0) > 0 and target:GetAttribute("Jailed") ~= true
				end
			elseif action == "ShopCounter" then
				local shop = promptShop(prompt)
				local owner = shop and shop:GetAttribute("Owner") or 0
				if owner == player.UserId then
					prompt.ActionText = "打開櫃檯"
				elseif owner == 0 then
					prompt.ActionText = "經營這間當舖"
					enabled = enabled and myJob == "Pawnbroker"
				else
					enabled = false
				end
			elseif action == "SellRelic" then
				local shop = promptShop(prompt)
				local owner = shop and shop:GetAttribute("Owner") or 0
				enabled = enabled and owner ~= 0 and owner ~= player.UserId and (player:GetAttribute("Relics") or 0) > 0
			elseif action == "SellCargo" then
				enabled = enabled and (player:GetAttribute("Cargo") or 0) > 0
			end
			if prompt.Enabled ~= enabled then
				prompt.Enabled = enabled
			end
		end
	end
end

task.spawn(function()
	while true do
		local ok, err = pcall(refreshPrompts)
		if not ok then
			warn("[Client] refreshPrompts：" .. tostring(err))
		end
		ui.UpdateLive({
			Wanted = player:GetAttribute("Wanted") or 0,
			Protection = player:GetAttribute("Protection") or "",
			Jailed = player:GetAttribute("Jailed") == true,
			JailedUntilUnix = player:GetAttribute("JailedUntilUnix") or 0,
		})
		task.wait(0.5)
	end
end)

-- 存檔可能比腳本先讀好，主動要一次狀態；還沒讀好的話伺服器會之後用 StateChanged 推過來
task.defer(function()
	local ok, response = pcall(function()
		return shopAction:InvokeServer("GetState")
	end)
	if ok and type(response) == "table" and response.State then
		applyState(response.State)
	end
end)



]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000028">
          <Properties>
            <string name="Name">UI</string>
            <ProtectedString name="Source"><![CDATA[-- 玩家介面：上方資訊列、左邊客人面板、右邊倉庫 / 商店 / 圖鑑面板、下方訊息。
-- 全部用程式碼建立，UI 設計師之後可以換成 Studio 裡做好的 ScreenGui。
--
-- UI.Create(playerGui, actions) 回傳 { Render = function(state), Toast = function(text, ok) }
-- actions 是一組函式：
--   Next / Inspect(toolId) / Offer(amount) / Reject / Sell(uid) / BuyTool(toolId) / ClaimDaily / RedeemCode(code)
--   ChooseJob(jobId) / CloseCounter / BuyInsurance
--
-- 兩種模式：
--   小鎮模式：左邊是職業指南、身上貨物、各地收購價；右邊的背包可以開關。
--   櫃檯模式（當舖老闆在櫃檯營業時）：左邊是客人，右邊是倉庫 / 商店 / 圖鑑。

local TweenService = game:GetService("TweenService")

local UI = {}

local COLORS = {
	Panel = Color3.fromRGB(22, 22, 38),
	PanelSoft = Color3.fromRGB(34, 34, 56),
	Stroke = Color3.fromRGB(90, 80, 170),
	Text = Color3.fromRGB(235, 235, 250),
	Muted = Color3.fromRGB(160, 160, 190),
	Accent = Color3.fromRGB(70, 220, 255),
	Good = Color3.fromRGB(110, 225, 140),
	Bad = Color3.fromRGB(255, 110, 110),
	Gold = Color3.fromRGB(255, 210, 90),
	Button = Color3.fromRGB(95, 80, 230),
	ButtonGold = Color3.fromRGB(215, 150, 30),
	ButtonDanger = Color3.fromRGB(190, 70, 90),
	ButtonDisabled = Color3.fromRGB(70, 70, 90),
}

local RARITY_COLORS = {
	Common = Color3.fromRGB(200, 200, 215),
	Rare = Color3.fromRGB(90, 170, 255),
	Epic = Color3.fromRGB(200, 120, 255),
	Legendary = Color3.fromRGB(255, 200, 70),
}

local VARIANT_COLORS = {
	Shiny = Color3.fromRGB(255, 235, 120),
	Rainbow = Color3.fromRGB(255, 130, 220),
}

local VARIANT_BADGES = {
	Shiny = "✨閃亮",
	Rainbow = "🌈彩虹",
}

local FONT = Enum.Font.BuilderSans
local FONT_BOLD = Enum.Font.BuilderSansBold

local function new(className, props, children)
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

local function stroke(color, thickness)
	return new("UIStroke", { Color = color or COLORS.Stroke, Thickness = thickness or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function padding(px)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

local function list(direction, gap)
	return new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

local function label(props)
	local base = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = COLORS.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 22),
	}
	for key, value in props do
		base[key] = value
	end
	return new("TextLabel", base)
end

-- 會依內容自動長高的文字
local function textBlock(props)
	local base = {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}
	for key, value in props do
		base[key] = value
	end
	return label(base)
end

local function button(text, color, onClick, props)
	local base = {
		Text = text,
		Font = FONT_BOLD,
		TextSize = 16,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = color or COLORS.Button,
		AutoButtonColor = true,
		Size = UDim2.new(1, 0, 0, 36),
	}
	if props then
		for key, value in props do
			base[key] = value
		end
	end
	local b = new("TextButton", base, { corner(8) })
	if onClick then
		b.Activated:Connect(function()
			onClick()
		end)
	end
	return b
end

local function card(parent, order, strokeColor)
	local children = { corner(10), padding(10), list(Enum.FillDirection.Vertical, 4) }
	if strokeColor then
		table.insert(children, stroke(strokeColor, 1.5))
	end
	return new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = COLORS.PanelSoft,
		LayoutOrder = order,
		Parent = parent,
	}, children)
end

-- 清掉 frame 裡的內容（保留排版用的 UI 元件）
local function clearChildren(frame)
	for _, child in frame:GetChildren() do
		-- UIComponent 包含 layout、padding、圓角、外框、尺寸限制，這些要留著
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
end

local function toneColor(tone)
	if tone == "good" then
		return COLORS.Good
	elseif tone == "bad" then
		return COLORS.Bad
	end
	return COLORS.Muted
end

local function itemColor(rarity, variant)
	return VARIANT_COLORS[variant] or RARITY_COLORS[rarity] or COLORS.Text
end

local function scrollPanel(props)
	local base = {
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = COLORS.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}
	for key, value in props do
		base[key] = value
	end
	return new("ScrollingFrame", base, { corner(12), stroke(), padding(12), list(Enum.FillDirection.Vertical, 8) })
end

function UI.Create(playerGui, actions)
	local gui = new("ScreenGui", {
		Name = "PawnShopUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})

	-- 上方資訊列 --------------------------------------------------------------
	local topBar = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0.9, 0, 0, 40),
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.08,
		Parent = gui,
	}, { corner(12), stroke(), padding(8), list(Enum.FillDirection.Horizontal, 12), new("UISizeConstraint", { MaxSize = Vector2.new(720, 40), MinSize = Vector2.new(300, 40) }) })

	local creditsLabel = label({ Text = "星幣 —", TextColor3 = COLORS.Gold, Font = FONT_BOLD, Size = UDim2.new(0.2, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, TextScaled = true, LayoutOrder = 1, Parent = topBar })
	local repLabel = label({ Text = "名聲 —", TextColor3 = COLORS.Accent, Font = FONT_BOLD, Size = UDim2.new(0.3, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, TextScaled = true, LayoutOrder = 2, Parent = topBar })
	local jobLabel = label({ Text = "選擇職業", TextColor3 = COLORS.Text, Font = FONT_BOLD, Size = UDim2.new(0.2, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, TextScaled = true, LayoutOrder = 3, Parent = topBar })
	local statusLabel = label({ Text = "", TextColor3 = COLORS.Good, Font = FONT_BOLD, Size = UDim2.new(0.22, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, TextScaled = true, LayoutOrder = 4, Parent = topBar })
	for _, l in { creditsLabel, repLabel, jobLabel, statusLabel } do
		new("UITextSizeConstraint", { MaxTextSize = 20, Parent = l })
	end

	-- 左邊：客人面板 ------------------------------------------------------------
	local customerPanel = scrollPanel({
		Name = "CustomerPanel",
		Position = UDim2.new(0, 12, 0, 60),
		Size = UDim2.new(0.4, 0, 1, -72),
		Parent = gui,
	})
	new("UISizeConstraint", { MaxSize = Vector2.new(420, 10000), Parent = customerPanel })

	-- 右邊：倉庫 / 商店 / 圖鑑 ---------------------------------------------------
	local rightHolder = new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 60),
		Size = UDim2.new(0.34, 0, 1, -72),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { new("UISizeConstraint", { MaxSize = Vector2.new(360, 10000) }) })

	local tabRow = new("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Parent = rightHolder,
	}, { list(Enum.FillDirection.Horizontal, 6) })

	local rightPanel = scrollPanel({
		Name = "SidePanel",
		Position = UDim2.new(0, 0, 0, 44),
		Size = UDim2.new(1, 0, 1, -44),
		Parent = rightHolder,
	})

	local offerDraft = { Id = nil, Text = "" }
	local codeDraft = ""
	local currentTab = "Inventory"
	local renderedTab = nil
	local lastState = nil
	local renderSide -- 前向宣告

	local tabButtons = {}
	local tabDefs = {
		{ Id = "Inventory", Text = "倉庫" },
		{ Id = "Shop", Text = "商店" },
		{ Id = "Codex", Text = "圖鑑" },
	}
	for i, def in tabDefs do
		tabButtons[def.Id] = button(def.Text, COLORS.PanelSoft, function()
			currentTab = def.Id
			renderSide()
		end, { Size = UDim2.new(1 / 3, -4, 1, 0), LayoutOrder = i, Parent = tabRow })
	end

	local bagButton = button("📒 背包", COLORS.Button, nil, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 60),
		Size = UDim2.new(0, 110, 0, 36),
		TextSize = 15,
		Parent = gui,
	})
	local bagOpen = false
	local function setBagOpen(open)
		bagOpen = open
		rightHolder.Visible = open
		bagButton.Text = open and "✖ 關閉" or "📒 背包"
		-- 背包打開時，按鈕移到背包下方，避免擋住分頁
		bagButton.Position = open and UDim2.new(1, -12, 1, -48) or UDim2.new(1, -12, 0, 60)
	end
	bagButton.Activated:Connect(function()
		setBagOpen(not bagOpen)
	end)

	-- 職業選單（置中的大視窗）
	local jobPicker = new("Frame", {
		Name = "JobPicker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.8, 0, 0.8, 0),
		BackgroundColor3 = COLORS.Panel,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	}, { corner(16), stroke(COLORS.Gold, 2), padding(16), new("UISizeConstraint", { MaxSize = Vector2.new(720, 520) }) })
	local jobPickerList = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 21,
		Parent = jobPicker,
	}, { list(Enum.FillDirection.Vertical, 10) })

	local function showJobPicker(state)
		local town = state and state.Town
		if not town then
			return
		end
		clearChildren(jobPickerList)
		label({ Text = "選擇你的職業", Font = FONT_BOLD, TextSize = 24, Size = UDim2.new(1, 0, 0, 32), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 22, LayoutOrder = 0, Parent = jobPickerList })
		textBlock({ Text = "之後隨時可以到廣場的「職業公告板」換職業。任何人都可以搶劫（保鑣除外），但會扣名聲、被通緝！", TextColor3 = COLORS.Muted, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 22, LayoutOrder = 1, Parent = jobPickerList })
		for i, job in town.Jobs do
			local c = job.Color or { 1, 1, 1 }
			local jobColor = Color3.new(c[1], c[2], c[3])
			local jobCard = card(jobPickerList, 10 + i, jobColor)
			jobCard.ZIndex = 22
			label({ Text = job.Icon .. " " .. job.Name, Font = FONT_BOLD, TextSize = 20, TextColor3 = jobColor, Size = UDim2.new(1, 0, 0, 26), ZIndex = 23, LayoutOrder = 1, Parent = jobCard })
			textBlock({ Text = job.Summary, TextColor3 = COLORS.Text, TextSize = 14, ZIndex = 23, LayoutOrder = 2, Parent = jobCard })
			local isCurrent = town.Job == job.Id
			button(isCurrent and "目前的職業" or ("當" .. job.Name), isCurrent and COLORS.ButtonDisabled or COLORS.Button, function()
				if not isCurrent then
					jobPicker.Visible = false
					actions.ChooseJob(job.Id)
				end
			end, { Size = UDim2.new(1, 0, 0, 34), TextSize = 15, ZIndex = 23, LayoutOrder = 3, Parent = jobCard })
		end
		if town.Job then
			button("先不換", COLORS.PanelSoft, function()
				jobPicker.Visible = false
			end, { Size = UDim2.new(1, 0, 0, 34), TextSize = 15, ZIndex = 22, LayoutOrder = 99, Parent = jobPickerList })
		end
		jobPicker.Visible = true
	end

	-- 坐牢畫面
	local jailBanner = label({
		Name = "JailBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 56),
		Size = UDim2.new(0, 340, 0, 44),
		BackgroundColor3 = Color3.fromRGB(90, 20, 30),
		BackgroundTransparency = 0.1,
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = FONT_BOLD,
		TextSize = 20,
		Visible = false,
		ZIndex = 15,
		Parent = gui,
	})
	corner(10).Parent = jailBanner

	-- 下方訊息 -----------------------------------------------------------------
	local toastLabel = textBlock({
		-- 放在上方（坐牢橫幅下面），下方中間留給聊天視窗
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 108),
		Size = UDim2.new(0.4, 0, 0, 0),
		BackgroundTransparency = 0.1,
		BackgroundColor3 = COLORS.Panel,
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = FONT_BOLD,
		TextSize = 17,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	corner(10).Parent = toastLabel
	stroke(COLORS.Accent).Parent = toastLabel
	padding(10).Parent = toastLabel

	local toastToken = 0
	local function toast(text, ok)
		if not text or text == "" then
			return
		end
		toastToken += 1
		local token = toastToken
		toastLabel.Text = text
		toastLabel.TextColor3 = (ok == false) and COLORS.Bad or COLORS.Text
		toastLabel.TextTransparency = 0
		toastLabel.BackgroundTransparency = 0.1
		toastLabel.Visible = true
		-- 訊息越長顯示越久
		local _, lineBreaks = string.gsub(text, "\n", "\n")
		local duration = 3.5 + lineBreaks * 1.5
		task.delay(duration, function()
			if token ~= toastToken then
				return
			end
			local info = TweenInfo.new(0.4)
			TweenService:Create(toastLabel, info, { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
			task.delay(0.45, function()
				if token == toastToken then
					toastLabel.Visible = false
				end
			end)
		end)
	end

	-- 小鎮模式的左邊面板 ------------------------------------------------------
	local function renderTown(state, nextOrder)
		local town = state.Town
		if not state.Persistent then
			textBlock({ Text = "⚠ 存檔未啟用：這次的進度不會被保存。", TextColor3 = COLORS.Gold, TextSize = 13, LayoutOrder = nextOrder(), Parent = customerPanel })
		end
		if state.Daily and state.Daily.Available then
			button(
				string.format("🎁 領取每日獎勵 +%d 星幣", state.Daily.Reward),
				COLORS.ButtonGold,
				actions.ClaimDaily,
				{ Size = UDim2.new(1, 0, 0, 36), TextSize = 14, LayoutOrder = nextOrder(), Parent = customerPanel }
			)
		end
		if not town then
			return
		end

		if not town.Job then
			label({ Text = "歡迎來到星塵鎮！", Font = FONT_BOLD, TextSize = 20, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = nextOrder(), Parent = customerPanel })
			button("選擇職業", COLORS.Button, function()
				showJobPicker(state)
			end, { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = nextOrder(), Parent = customerPanel })
			return
		end

		-- 職業指南
		label({ Text = town.JobIcon .. " " .. town.JobName, Font = FONT_BOLD, TextSize = 20, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = nextOrder(), Parent = customerPanel })
		for i, step in town.JobSteps do
			textBlock({ Text = string.format("%d. %s", i, step), TextColor3 = COLORS.Muted, TextSize = 13, LayoutOrder = nextOrder(), Parent = customerPanel })
		end

		-- 當舖老闆：店面狀態
		if town.Job == "Pawnbroker" then
			if state.Shop then
				local text = string.format("你經營 %d 號當舖。走到櫃檯按「打開櫃檯」開始營業。", state.Shop.Index)
				if state.Shop.QueueCount > 0 then
					text ..= string.format("\n📦 有 %d 位玩家商人在排隊等你出價！", state.Shop.QueueCount)
				end
				textBlock({ Text = text, TextColor3 = COLORS.Accent, Font = FONT_BOLD, TextSize = 14, LayoutOrder = nextOrder(), Parent = customerPanel })
			else
				textBlock({ Text = "你還沒有店面。到廣場北邊的商店街，找一間「空店面」經營。", TextColor3 = COLORS.Gold, Font = FONT_BOLD, TextSize = 14, LayoutOrder = nextOrder(), Parent = customerPanel })
			end
		end

		-- 身上的貨物
		local cargoCard = card(customerPanel, nextOrder())
		label({ Text = string.format("📦 身上的貨物（%d / %d）", #town.Cargo, town.Capacity), Font = FONT_BOLD, TextSize = 15, LayoutOrder = 1, Parent = cargoCard })
		if #town.Cargo == 0 then
			textBlock({ Text = town.Job == "Merchant" and "空的。出城到礦場或墜毀點採集吧！" or "空的。", TextColor3 = COLORS.Muted, TextSize = 13, LayoutOrder = 2, Parent = cargoCard })
		else
			-- 同名的貨物合併顯示
			local counts, orderList = {}, {}
			for _, item in town.Cargo do
				if not counts[item.Name] then
					counts[item.Name] = { Count = 0, Stolen = item.Stolen, Relic = item.Kind == "Relic" }
					table.insert(orderList, item.Name)
				end
				counts[item.Name].Count += 1
			end
			for i, name in orderList do
				local info = counts[name]
				local color = info.Stolen and COLORS.Bad or (info.Relic and COLORS.Gold or COLORS.Text)
				textBlock({ Text = string.format("• %s ×%d", name, info.Count), TextColor3 = color, TextSize = 13, LayoutOrder = 1 + i, Parent = cargoCard })
			end
		end

		-- 各地收購價（商人才需要，劫匪銷贓也看得到黑市）
		if town.Job == "Merchant" or #town.Cargo > 0 then
			local priceCard = card(customerPanel, nextOrder())
			label({ Text = "💰 現在的收購價", Font = FONT_BOLD, TextSize = 15, LayoutOrder = 1, Parent = priceCard })
			for i, row in town.Prices do
				local parts = {}
				for _, price in row.Prices do
					table.insert(parts, string.format("%s %d", price.Name, price.Price))
				end
				textBlock({ Text = row.Buyer .. "：" .. table.concat(parts, "　"), TextColor3 = (row.Buyer == "黑市") and COLORS.Bad or COLORS.Muted, TextSize = 13, LayoutOrder = 1 + i, Parent = priceCard })
			end
			textBlock({ Text = "黑市什麼都收（包括贓物），但價格最差。", TextColor3 = COLORS.Muted, TextSize = 12, LayoutOrder = 20, Parent = priceCard })
		end

		-- 保護
		local protectCard = card(customerPanel, nextOrder())
		label({ Text = string.format("🛡️ 搶劫保險：%d / %d 份", town.Insurance, town.InsuranceMax), Font = FONT_BOLD, TextSize = 14, LayoutOrder = 1, Parent = protectCard })
		textBlock({ Text = "被搶時理賠一部分損失。安全區、新手保護、保鑣護送時都不會被搶。", TextColor3 = COLORS.Muted, TextSize = 12, LayoutOrder = 2, Parent = protectCard })
		if town.Insurance < town.InsuranceMax then
			button(string.format("買一份保險（%d 星幣）", town.InsurancePrice), COLORS.PanelSoft, actions.BuyInsurance, { Size = UDim2.new(1, 0, 0, 30), TextSize = 13, LayoutOrder = 3, Parent = protectCard })
		end

		button("換職業", COLORS.PanelSoft, function()
			showJobPicker(state)
		end, { Size = UDim2.new(1, 0, 0, 32), TextSize = 14, LayoutOrder = nextOrder(), Parent = customerPanel })
	end

	-- 客人面板內容 ------------------------------------------------------------
	local function renderCustomer(state)
		clearChildren(customerPanel)
		local customer = state.Customer
		local order = 0
		local function nextOrder()
			order += 1
			return order
		end

		local atCounter = state.Shop ~= nil and state.Shop.CounterOpen
		if not atCounter then
			renderTown(state, nextOrder)
			return
		end

		button("🚪 打烊（離開櫃檯）", COLORS.ButtonDanger, actions.CloseCounter, { Size = UDim2.new(1, 0, 0, 34), TextSize = 14, LayoutOrder = nextOrder(), Parent = customerPanel })
		if state.Shop.QueueCount > 0 then
			textBlock({ Text = string.format("📦 有 %d 位玩家商人在排隊", state.Shop.QueueCount), TextColor3 = COLORS.Gold, Font = FONT_BOLD, TextSize = 14, LayoutOrder = nextOrder(), Parent = customerPanel })
		end

		if not state.Persistent then
			textBlock({ Text = "⚠ 存檔未啟用：這次的進度不會被保存。", TextColor3 = COLORS.Gold, TextSize = 14, LayoutOrder = nextOrder(), Parent = customerPanel })
		end

		-- 每日獎勵
		if state.Daily and state.Daily.Available then
			button(
				string.format("🎁 領取每日獎勵 +%d 星幣（連續第 %d 天）", state.Daily.Reward, state.Daily.Streak),
				COLORS.ButtonGold,
				actions.ClaimDaily,
				{ Size = UDim2.new(1, 0, 0, 40), TextSize = 15, LayoutOrder = nextOrder(), Parent = customerPanel }
			)
		end

		-- 銀河新聞
		if state.News then
			local newsCard = card(customerPanel, nextOrder(), COLORS.Accent)
			local minutes = math.max(1, math.ceil(state.News.SecondsLeft / 60))
			label({ Text = "📰 " .. state.News.Title, Font = FONT_BOLD, TextColor3 = COLORS.Accent, TextSize = 15, LayoutOrder = 1, Parent = newsCard })
			textBlock({ Text = string.format("%s（約 %d 分鐘後換新聞）", state.News.Description, minutes), TextColor3 = COLORS.Muted, TextSize = 13, LayoutOrder = 2, Parent = newsCard })
		end

		if not customer then
			label({ Text = "店裡現在沒有客人", Font = FONT_BOLD, TextSize = 22, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = nextOrder(), Parent = customerPanel })
			textBlock({ Text = "叫下一位客人進來，鑑定他帶來的東西，用比「行情價」低的價格收購，再到右邊的倉庫賣到市場賺差價。小心假貨！", TextColor3 = COLORS.Muted, LayoutOrder = nextOrder(), Parent = customerPanel })
			button("下一位客人", COLORS.Button, actions.Next, { Size = UDim2.new(1, 0, 0, 44), LayoutOrder = nextOrder(), Parent = customerPanel })
			return
		end

		label({ Text = customer.Name .. "（" .. customer.Species .. "）", Font = FONT_BOLD, TextSize = 22, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = nextOrder(), Parent = customerPanel })
		if customer.IsPlayerSeller then
			textBlock({ Text = "這是真的玩家！成交的錢會付給他。", TextColor3 = COLORS.Gold, TextSize = 13, LayoutOrder = nextOrder(), Parent = customerPanel })
		end
		if customer.Stolen then
			textBlock({ Text = "⚠ 這件是贓物。收下會扣 2 點名聲。", TextColor3 = COLORS.Bad, Font = FONT_BOLD, TextSize = 14, LayoutOrder = nextOrder(), Parent = customerPanel })
		end

		local bubble = new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = COLORS.PanelSoft,
			LayoutOrder = nextOrder(),
			Parent = customerPanel,
		}, { corner(10), padding(10) })
		textBlock({ Text = "「" .. customer.Line .. "」", Parent = bubble })

		textBlock({ Text = customer.ItemName, Font = FONT_BOLD, TextSize = 18, TextColor3 = itemColor(customer.Rarity, customer.Variant), LayoutOrder = nextOrder(), Parent = customerPanel })
		label({ Text = customer.RarityName .. "　·　" .. customer.Category, TextSize = 14, TextColor3 = RARITY_COLORS[customer.Rarity] or COLORS.Muted, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = nextOrder(), Parent = customerPanel })
		if VARIANT_BADGES[customer.Variant] then
			textBlock({
				Text = string.format("%s版！價值是普通版的 %d 倍", VARIANT_BADGES[customer.Variant], customer.VariantMultiplier),
				Font = FONT_BOLD,
				TextSize = 15,
				TextColor3 = VARIANT_COLORS[customer.Variant],
				LayoutOrder = nextOrder(),
				Parent = customerPanel,
			})
		end
		textBlock({ Text = customer.ItemDescription, TextColor3 = COLORS.Muted, TextSize = 15, LayoutOrder = nextOrder(), Parent = customerPanel })
		label({ Text = string.format("客人開價：%d 星幣", customer.AskingPrice), Font = FONT_BOLD, TextColor3 = COLORS.Gold, TextSize = 18, LayoutOrder = nextOrder(), Parent = customerPanel })
		if customer.MarketPrice then
			textBlock({
				Text = string.format("行情價：%d 星幣（真品而且沒瑕疵才賣得到這個價）", customer.MarketPrice),
				TextColor3 = COLORS.Accent,
				TextSize = 14,
				LayoutOrder = nextOrder(),
				Parent = customerPanel,
			})
		end

		if customer.Floor then
			label({ Text = string.format("讀心眼鏡：他心裡的底價是 %d", customer.Floor), TextColor3 = COLORS.Good, TextSize = 15, LayoutOrder = nextOrder(), Parent = customerPanel })
		end
		if customer.FakeChance then
			label({ Text = string.format("天眼掃描儀：這類物品約 %d%% 是假貨", math.floor(customer.FakeChance * 100 + 0.5)), TextColor3 = COLORS.Good, TextSize = 15, LayoutOrder = nextOrder(), Parent = customerPanel })
		end

		-- 耐心條
		local maxPatience = math.max(1, customer.MaxPatience or 100)
		label({ Text = string.format("耐心 %d / %d", customer.Patience, maxPatience), TextColor3 = COLORS.Muted, TextSize = 14, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = nextOrder(), Parent = customerPanel })
		local barBack = new("Frame", { Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = COLORS.PanelSoft, LayoutOrder = nextOrder(), Parent = customerPanel }, { corner(5) })
		local ratio = math.clamp(customer.Patience / maxPatience, 0, 1)
		new("Frame", {
			Size = UDim2.new(ratio, 0, 1, 0),
			BackgroundColor3 = COLORS.Good:Lerp(COLORS.Bad, 1 - ratio),
			Parent = barBack,
		}, { corner(5) })

		-- 鑑定結果
		label({ Text = "鑑定紀錄", Font = FONT_BOLD, TextSize = 16, LayoutOrder = nextOrder(), Parent = customerPanel })
		if #customer.Findings == 0 then
			textBlock({ Text = "還沒鑑定。用下面的工具檢查看看（會消耗客人的耐心）。", TextColor3 = COLORS.Muted, TextSize = 14, LayoutOrder = nextOrder(), Parent = customerPanel })
		else
			for _, finding in customer.Findings do
				textBlock({ Text = "• " .. finding.Tool .. "：" .. finding.Text, TextColor3 = toneColor(finding.Tone), TextSize = 15, LayoutOrder = nextOrder(), Parent = customerPanel })
			end
		end

		-- 工具按鈕
		local toolGrid = new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = nextOrder(),
			Parent = customerPanel,
		}, { new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 36), CellPadding = UDim2.new(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
		for i, tool in state.Tools do
			if tool.Owned then
				local used = tool.UsedOnCustomer
				local b = button(
					used and (tool.Name .. " ✓") or string.format("%s（-%d）", tool.Name, tool.PatienceCost),
					used and COLORS.ButtonDisabled or COLORS.PanelSoft,
					function()
						if not used then
							actions.Inspect(tool.Id)
						end
					end,
					{ LayoutOrder = i, TextSize = 14, AutoButtonColor = not used, Parent = toolGrid }
				)
				stroke(COLORS.Stroke, 1).Parent = b
			end
		end

		-- 出價
		local offerRow = new("Frame", {
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundTransparency = 1,
			LayoutOrder = nextOrder(),
			Parent = customerPanel,
		}, { list(Enum.FillDirection.Horizontal, 8) })
		local offerBox = new("TextBox", {
			Size = UDim2.new(0.6, -4, 1, 0),
			BackgroundColor3 = COLORS.PanelSoft,
			TextColor3 = COLORS.Text,
			PlaceholderText = "輸入你的出價",
			PlaceholderColor3 = COLORS.Muted,
			-- 同一位客人重畫介面時，保留剛剛輸入的出價
			Text = (offerDraft.Id == customer.Id) and offerDraft.Text or "",
			Font = FONT_BOLD,
			TextSize = 18,
			ClearTextOnFocus = false,
			LayoutOrder = 1,
			Parent = offerRow,
		}, { corner(8), stroke(COLORS.Stroke, 1) })
		offerBox:GetPropertyChangedSignal("Text"):Connect(function()
			local digits = string.gsub(offerBox.Text, "%D", "")
			if digits ~= offerBox.Text then
				offerBox.Text = digits
				return
			end
			offerDraft.Id = customer.Id
			offerDraft.Text = digits
		end)
		local function submitOffer()
			local amount = tonumber(offerBox.Text)
			if not amount or amount < 1 then
				toast("先輸入一個價格。", false)
				return
			end
			actions.Offer(math.floor(amount))
		end
		button("出價", COLORS.Button, submitOffer, { Size = UDim2.new(0.4, -4, 1, 0), LayoutOrder = 2, Parent = offerRow })
		offerBox.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				submitOffer()
			end
		end)

		local quickRow = new("Frame", {
			Size = UDim2.new(1, 0, 0, 36),
			BackgroundTransparency = 1,
			LayoutOrder = nextOrder(),
			Parent = customerPanel,
		}, { list(Enum.FillDirection.Horizontal, 8) })
		-- 快速出價：開價的 50% / 70%
		for i, pct in { 50, 70 } do
			local value = math.max(1, math.floor(customer.AskingPrice * pct / 100))
			button(string.format("%d%%（%d）", pct, value), COLORS.PanelSoft, function()
				offerBox.Text = tostring(value)
			end, { Size = UDim2.new(0.33, -6, 1, 0), TextSize = 14, LayoutOrder = i, Parent = quickRow })
		end
		button("不收了", COLORS.ButtonDanger, actions.Reject, { Size = UDim2.new(0.34, -4, 1, 0), TextSize = 14, LayoutOrder = 3, Parent = quickRow })
	end

	-- 右邊面板內容 ------------------------------------------------------------
	local function renderInventory(state)
		label({ Text = string.format("倉庫（%d / %d）", #state.Inventory, state.InventoryLimit), Font = FONT_BOLD, TextSize = 18, LayoutOrder = 0, Parent = rightPanel })
		if #state.Inventory == 0 then
			textBlock({ Text = "倉庫是空的。收購的東西會出現在這裡，按「賣到市場」就會揭曉真假並換成星幣。", TextColor3 = COLORS.Muted, TextSize = 14, LayoutOrder = 1, Parent = rightPanel })
			return
		end
		for i, item in state.Inventory do
			local itemCard = card(rightPanel, i, VARIANT_COLORS[item.Variant])
			textBlock({ Text = item.Name, Font = FONT_BOLD, TextSize = 16, TextColor3 = itemColor(item.Rarity, item.Variant), LayoutOrder = 1, Parent = itemCard })
			label({ Text = string.format("%s　·　收購價 %d 星幣", item.RarityName, item.PaidPrice), TextColor3 = COLORS.Gold, TextSize = 14, LayoutOrder = 2, Parent = itemCard })
			if item.NewsMultiplier and item.NewsMultiplier > 1 then
				label({ Text = string.format("📈 新聞加成：現在賣價 ×%.1f", item.NewsMultiplier), TextColor3 = COLORS.Good, Font = FONT_BOLD, TextSize = 14, LayoutOrder = 3, Parent = itemCard })
			end
			local notes = #item.Findings > 0 and table.concat(item.Findings, "\n") or "（沒有鑑定紀錄）"
			textBlock({ Text = notes, TextColor3 = COLORS.Muted, TextSize = 13, LayoutOrder = 4, Parent = itemCard })
			button("賣到市場", COLORS.Button, function()
				actions.Sell(item.Uid)
			end, { Size = UDim2.new(1, 0, 0, 32), TextSize = 15, LayoutOrder = 5, Parent = itemCard })
		end
	end

	local function renderShop(state)
		label({ Text = "工具商店", Font = FONT_BOLD, TextSize = 18, LayoutOrder = 0, Parent = rightPanel })
		for i, tool in state.Tools do
			local toolCard = card(rightPanel, i)
			label({ Text = tool.Name, Font = FONT_BOLD, TextSize = 16, LayoutOrder = 1, Parent = toolCard })
			textBlock({ Text = tool.Description, TextColor3 = COLORS.Muted, TextSize = 13, LayoutOrder = 2, Parent = toolCard })
			label({ Text = string.format("每次使用 -%d 耐心", tool.PatienceCost), TextColor3 = COLORS.Muted, TextSize = 13, LayoutOrder = 3, Parent = toolCard })
			if tool.Owned then
				button("已擁有", COLORS.ButtonDisabled, nil, { Size = UDim2.new(1, 0, 0, 32), TextSize = 15, AutoButtonColor = false, LayoutOrder = 4, Parent = toolCard })
			else
				local affordable = state.Credits >= tool.Price
				button(string.format("購買（%d 星幣）", tool.Price), affordable and COLORS.Button or COLORS.ButtonDisabled, function()
					actions.BuyTool(tool.Id)
				end, { Size = UDim2.new(1, 0, 0, 32), TextSize = 15, LayoutOrder = 4, Parent = toolCard })
			end
		end

		-- 兌換碼
		local codeCard = card(rightPanel, 100)
		label({ Text = "兌換碼", Font = FONT_BOLD, TextSize = 16, LayoutOrder = 1, Parent = codeCard })
		local codeRow = new("Frame", {
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundTransparency = 1,
			LayoutOrder = 2,
			Parent = codeCard,
		}, { list(Enum.FillDirection.Horizontal, 6) })
		local codeBox = new("TextBox", {
			Size = UDim2.new(0.62, -3, 1, 0),
			BackgroundColor3 = COLORS.Panel,
			TextColor3 = COLORS.Text,
			PlaceholderText = "輸入兌換碼",
			PlaceholderColor3 = COLORS.Muted,
			Text = codeDraft,
			Font = FONT_BOLD,
			TextSize = 15,
			ClearTextOnFocus = false,
			LayoutOrder = 1,
			Parent = codeRow,
		}, { corner(8), stroke(COLORS.Stroke, 1) })
		codeBox:GetPropertyChangedSignal("Text"):Connect(function()
			codeDraft = string.sub(codeBox.Text, 1, 32)
		end)
		button("兌換", COLORS.ButtonGold, function()
			local code = codeDraft
			if code == "" then
				toast("先輸入兌換碼。", false)
				return
			end
			codeDraft = ""
			actions.RedeemCode(code)
		end, { Size = UDim2.new(0.38, -3, 1, 0), TextSize = 15, LayoutOrder = 2, Parent = codeRow })
	end

	local function renderCodex(state)
		-- 稱號
		local rankCard = card(rightPanel, 1, COLORS.Accent)
		label({ Text = "稱號：" .. state.Rank.Title, Font = FONT_BOLD, TextColor3 = COLORS.Accent, TextSize = 16, LayoutOrder = 1, Parent = rankCard })
		if state.Rank.NextTitle then
			textBlock({ Text = string.format("名聲到 %d 升級為「%s」（目前 %d）", state.Rank.NextAt, state.Rank.NextTitle, state.Reputation), TextColor3 = COLORS.Muted, TextSize = 13, LayoutOrder = 2, Parent = rankCard })
		else
			label({ Text = "已經是最高稱號！", TextColor3 = COLORS.Gold, TextSize = 13, LayoutOrder = 2, Parent = rankCard })
		end

		-- 套裝
		label({ Text = "套裝加成", Font = FONT_BOLD, TextSize = 18, LayoutOrder = 10, Parent = rightPanel })
		for i, set in state.Sets do
			local setCard = card(rightPanel, 10 + i, set.Done and COLORS.Good or nil)
			label({
				Text = string.format("%s%s（%d / %d）", set.Done and "✅ " or "", set.Name, set.Have, set.Total),
				Font = FONT_BOLD,
				TextSize = 15,
				TextColor3 = set.Done and COLORS.Good or COLORS.Text,
				LayoutOrder = 1,
				Parent = setCard,
			})
			textBlock({ Text = set.Description, TextColor3 = COLORS.Muted, TextSize = 13, LayoutOrder = 2, Parent = setCard })
		end

		-- 物品圖鑑
		label({ Text = string.format("物品圖鑑（%d / %d）", state.CodexCount, state.ItemCount), Font = FONT_BOLD, TextSize = 18, LayoutOrder = 30, Parent = rightPanel })
		local codexCard = card(rightPanel, 31)
		for i, entry in state.Codex do
			local text
			local color
			if entry.Collected then
				local badge = VARIANT_BADGES[entry.Variant]
				text = string.format("%s%s　·　%s", badge and (badge .. " ") or "", entry.Name, entry.RarityName)
				color = itemColor(entry.Rarity, entry.Variant)
			else
				text = string.format("？？？　·　%s %s", entry.RarityName, entry.Category)
				if entry.MinReputation > state.Reputation then
					text ..= string.format("（名聲 %d 出現）", entry.MinReputation)
				end
				color = COLORS.Muted
			end
			textBlock({ Text = text, TextColor3 = color, TextSize = 14, LayoutOrder = i, Parent = codexCard })
		end

		-- 成就
		label({ Text = "成就", Font = FONT_BOLD, TextSize = 18, LayoutOrder = 50, Parent = rightPanel })
		for i, achievement in state.Achievements do
			local achievementCard = card(rightPanel, 50 + i, achievement.Done and COLORS.Gold or nil)
			label({
				Text = string.format("%s%s", achievement.Done and "🏆 " or "", achievement.Name),
				Font = FONT_BOLD,
				TextSize = 15,
				TextColor3 = achievement.Done and COLORS.Gold or COLORS.Text,
				LayoutOrder = 1,
				Parent = achievementCard,
			})
			textBlock({
				Text = string.format("%s（%d / %d）　獎勵 %d 星幣", achievement.Description, achievement.Progress, achievement.Goal, achievement.Reward),
				TextColor3 = COLORS.Muted,
				TextSize = 13,
				LayoutOrder = 2,
				Parent = achievementCard,
			})
		end
	end

	renderSide = function()
		for id, tabButton in tabButtons do
			tabButton.BackgroundColor3 = (id == currentTab) and COLORS.Button or COLORS.PanelSoft
		end
		-- 同一個分頁重畫時保留捲動位置，換分頁就回到最上面
		local scrollPosition = (renderedTab == currentTab) and rightPanel.CanvasPosition or Vector2.zero
		renderedTab = currentTab
		clearChildren(rightPanel)
		if not lastState then
			return
		end
		if currentTab == "Inventory" then
			renderInventory(lastState)
		elseif currentTab == "Shop" then
			renderShop(lastState)
		else
			renderCodex(lastState)
		end
		task.defer(function()
			rightPanel.CanvasPosition = scrollPosition
		end)
	end

	local lastMode = nil
	local function render(state)
		lastState = state
		creditsLabel.Text = string.format("星幣 %d", state.Credits)
		repLabel.Text = string.format("名聲 %d · %s", state.Reputation, state.Rank.Title)
		local town = state.Town
		if town and town.Job then
			jobLabel.Text = town.JobIcon .. " " .. town.JobName
		else
			jobLabel.Text = "還沒選職業"
		end

		-- 櫃檯模式：左邊大面板 + 右邊背包打開；小鎮模式：左邊小面板、背包收起來
		local mode = (state.Shop and state.Shop.CounterOpen) and "Counter" or "Town"
		if mode ~= lastMode then
			lastMode = mode
			if mode == "Counter" then
				customerPanel.Size = UDim2.new(0.4, 0, 1, -72)
				setBagOpen(true)
			else
				customerPanel.Size = UDim2.new(0.3, 0, 0.62, 0)
				setBagOpen(false)
			end
		end

		renderCustomer(state)
		renderSide()

		-- 剛進遊戲還沒選職業：自動打開職業選單
		if town and not town.Job and not jobPicker.Visible then
			showJobPicker(state)
		end
	end

	-- 每半秒用 Player 的 Attribute 更新即時狀態（通緝、保護、坐牢倒數）
	local function updateLive(info)
		if info.Jailed then
			local left = math.max(0, (info.JailedUntilUnix or 0) - os.time())
			jailBanner.Text = string.format("⛓ 坐牢中…還有 %d 秒", left)
			jailBanner.Visible = true
		else
			jailBanner.Visible = false
		end
		if (info.Wanted or 0) > 0 then
			statusLabel.Text = "通緝 " .. string.rep("⭐", info.Wanted)
			statusLabel.TextColor3 = COLORS.Bad
		elseif info.Protection and info.Protection ~= "" then
			statusLabel.Text = "🛡️ " .. info.Protection
			statusLabel.TextColor3 = COLORS.Good
		else
			statusLabel.Text = "⚠ 可能被搶"
			statusLabel.TextColor3 = COLORS.Gold
		end
	end

	label({ Text = "連線中…", TextColor3 = COLORS.Muted, Parent = customerPanel })
	renderSide()

	setBagOpen(false)

	return {
		Render = render,
		Toast = toast,
		UpdateLive = updateLive,
		ShowJobPicker = function()
			if lastState then
				showJobPicker(lastState)
			end
		end,
		IsJobPickerOpen = function()
			return jobPicker.Visible
		end,
		-- 切換右邊的分頁："Inventory" / "Shop" / "Codex"
		SetTab = function(tabId)
			if tabButtons[tabId] then
				currentTab = tabId
				renderSide()
			end
		end,
		Gui = gui,
	}
end

return UI
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>
