      <Item class="ModuleScript" referent="RBX00000015">
        <Properties>
          <string name="Name">Jobs</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 職業。第一階段有當舖老闆、商人、保鑣；店家和科學家之後再加。
-- 任何職業都可以搶劫（保鑣除外），做壞事會扣名聲、增加通緝等級。

export type JobDef = {
	Id: string,
	Name: string,
	Icon: string,
	Color: { number },
	Summary: string,
	Steps: { string },
}

local Jobs = {}

Jobs.List = {
	{
		Id = "Pawnbroker",
		Name = "當舖老闆",
		Icon = "🏪",
		Color = { 0.55, 0.45, 1 },
		Summary = "在商店街開一間當舖，鑑定真假、殺價收購，再轉賣賺差價。",
		Steps = {
			"到商店街找一間空的當舖，按「經營這間當舖」",
			"按「打開櫃檯」開始接客人",
			"玩家商人也會把挖到的遺物拿來賣你",
		},
	},
	{
		Id = "Merchant",
		Name = "商人",
		Icon = "📦",
		Color = { 0.95, 0.75, 0.3 },
		Summary = "到城外的礦場和墜毀點採集貨物，運回城鎮賣錢。路上小心劫匪！",
		Steps = {
			"出城到「隕石礦場」或「飛碟墜毀點」採集貨物",
			"運回城裡賣給「貿易站」或「研究院」（兩邊收購價不一樣）",
			"挖到的遺物可以賣給玩家當舖，價格比較好",
			"找保鑣護送就不會被搶",
		},
	},
	{
		Id = "Guard",
		Name = "保鑣",
		Icon = "🛡️",
		Color = { 0.4, 0.75, 1 },
		Summary = "保護商人、抓通緝犯拿賞金。保鑣不能搶劫。",
		Steps = {
			"跟在帶貨的商人旁邊就算護送，會自動拿到護送費",
			"頭上有⭐的是通緝犯，靠近按「逮捕」拿賞金",
			"通緝等級越高，賞金越多",
		},
	},
} :: { JobDef }

local byId: { [string]: JobDef } = {}
for _, job in Jobs.List do
	byId[job.Id] = job
end

function Jobs.Get(id: string?): JobDef?
	if id == nil then
		return nil
	end
	return byId[id]
end

function Jobs.IsValid(id: any): boolean
	return type(id) == "string" and byId[id] ~= nil
end

return Jobs
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000016">
        <Properties>
          <string name="Name">PlayerDataSchema</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 玩家存檔結構。新增欄位時加在 Template 裡，Reconcile 會自動補到舊存檔上。

export type InventoryEntry = {
	Uid: string,
	ItemId: string,
	IsFake: boolean,
	DefectType: string?,
	Variant: string?,
	PaidPrice: number,
	Findings: { string },
}

export type PlayerData = {
	Version: number,
	Credits: number,
	Reputation: number,
	UnlockedTools: { [string]: boolean },
	Inventory: { InventoryEntry },
	Codex: { [string]: any }, -- 物品 ID → 收購過的最高變種（"Normal" / "Shiny" / "Rainbow"）
	Daily: { LastDay: number, Streak: number },
	Achievements: { [string]: boolean },
	RedeemedCodes: { [string]: boolean },
	Insurance: number,
	LastJob: string,
	Stats: {
		DealsMade: number,
		ItemsSold: number,
		FakesSold: number,
		FakesSpotted: number,
		ShiniesFound: number,
		TotalProfit: number,
	},
}

local PlayerDataSchema = {}

PlayerDataSchema.Version = 1

PlayerDataSchema.Template = {
	Version = 1,
	Credits = 300, -- 開店資金
	Reputation = 0,
	UnlockedTools = { Magnifier = true },
	Inventory = {},
	Codex = {}, -- 圖鑑：物品 ID → 收購過的最高變種
	Daily = { LastDay = 0, Streak = 0 }, -- 每日登入獎勵
	Achievements = {}, -- 已達成的成就 ID → true
	RedeemedCodes = {}, -- 已兌換的兌換碼 → true
	Insurance = 0, -- 剩幾次搶劫保險
	LastJob = "", -- 上次選的職業
	Stats = {
		DealsMade = 0,
		ItemsSold = 0,
		FakesSold = 0,
		FakesSpotted = 0, -- 識破假貨後趕走客人的次數
		ShiniesFound = 0, -- 收購過的閃亮 / 彩虹物品數
		TotalProfit = 0,
	},
}

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

PlayerDataSchema.DeepCopy = deepCopy

function PlayerDataSchema.New(): PlayerData
	return deepCopy(PlayerDataSchema.Template)
end

-- 把 Template 有、舊存檔沒有的欄位補上（不覆蓋已有的值）
function PlayerDataSchema.Reconcile(data: any): PlayerData
	if type(data) ~= "table" then
		return PlayerDataSchema.New()
	end
	local function fill(target: any, template: any)
		for k, v in template do
			if target[k] == nil then
				target[k] = deepCopy(v)
			elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil then
				fill(target[k], v)
			end
		end
	end
	fill(data, PlayerDataSchema.Template)
	data.Version = PlayerDataSchema.Version
	return data
end

return PlayerDataSchema
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000017">
        <Properties>
          <string name="Name">Progression</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 稱號（依名聲）與每日登入獎勵。純計算，數值都在 Config。

local Config = require(script.Parent.Config)

export type Rank = { MinReputation: number, Title: string }
export type Daily = { LastDay: number, Streak: number }

local Progression = {}

-- 回傳 (目前稱號, 下一個稱號或 nil)
function Progression.GetRank(reputation: number): (Rank, Rank?)
	local ranks = Config.Ranks
	local current = ranks[1]
	local nextRank = nil
	for i, rank in ranks do
		if reputation >= rank.MinReputation then
			current = rank
			nextRank = ranks[i + 1]
		end
	end
	return current, nextRank
end

-- 今天是第幾天（UTC，從 1970 年算起）
function Progression.Today(): number
	return math.floor(os.time() / 86400)
end

-- 查看每日獎勵：回傳 (今天能不能領, 領了之後是連續第幾天, 獎勵星幣)
function Progression.PeekDaily(daily: Daily, today: number): (boolean, number, number)
	if today <= daily.LastDay then
		return false, daily.Streak, 0
	end
	local streak = 1
	if today == daily.LastDay + 1 then
		streak = daily.Streak + 1
	end
	local rewards = Config.DailyRewards
	local reward = rewards[math.min(streak, #rewards)]
	return true, streak, reward
end

-- 領取每日獎勵：成功回傳獎勵星幣，今天已經領過回傳 nil
function Progression.ClaimDaily(daily: Daily, today: number): number?
	local available, streak, reward = Progression.PeekDaily(daily, today)
	if not available then
		return nil
	end
	daily.LastDay = today
	daily.Streak = streak
	return reward
end

return Progression
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000018">
        <Properties>
          <string name="Name">Tools</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 鑑定工具。每次使用都會消耗客人的耐心值（PatienceCost）。

export type ToolDef = {
	Id: string,
	Name: string,
	Price: number,
	PatienceCost: number,
	Description: string,
}

local Tools = {}

Tools.List = {
	Magnifier = {
		Id = "Magnifier",
		Name = "放大鏡",
		Price = 0,
		PatienceCost = 4,
		Description = "看清表面的刮痕、接縫與做工。開店就有。",
	},
	XRay = {
		Id = "XRay",
		Name = "X 光掃描儀",
		Price = 250,
		PatienceCost = 6,
		Description = "看穿外殼，找出內部裂痕與空心假貨。",
	},
	UVLight = {
		Id = "UVLight",
		Name = "紫外線燈",
		Price = 700,
		PatienceCost = 6,
		Description = "照出防偽印記與肉眼看不到的混濁。",
	},
	Analyzer = {
		Id = "Analyzer",
		Name = "成分分析儀",
		Price = 1500,
		PatienceCost = 8,
		Description = "分析材質成分，識破最高明的仿冒品。",
	},
} :: { [string]: ToolDef }

-- UI 顯示順序
Tools.Order = { "Magnifier", "XRay", "UVLight", "Analyzer" }

function Tools.Get(id: string): ToolDef?
	return Tools.List[id]
end

return Tools
]]></ProtectedString>
