      <Item class="ModuleScript" referent="RBX0000000C">
        <Properties>
          <string name="Name">Achievements</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 成就：某個統計數字達到目標就發獎勵星幣。
-- Stat 對應玩家存檔的 Stats 欄位；CodexCount 是伺服器另外算好放進來的。

local ItemDatabase = require(script.Parent.ItemDatabase)

export type AchievementDef = {
	Id: string,
	Name: string,
	Description: string,
	Stat: string,
	Goal: number,
	Reward: number,
}

local Achievements = {}

Achievements.List = {
	{ Id = "FirstDeal", Name = "開張大吉", Description = "完成第一筆收購", Stat = "DealsMade", Goal = 1, Reward = 50 },
	{ Id = "Sold10", Name = "小小商人", Description = "賣出 10 件物品", Stat = "ItemsSold", Goal = 10, Reward = 150 },
	{ Id = "Deals25", Name = "生意興隆", Description = "完成 25 筆收購", Stat = "DealsMade", Goal = 25, Reward = 300 },
	{ Id = "Deals100", Name = "百件達人", Description = "完成 100 筆收購", Stat = "DealsMade", Goal = 100, Reward = 1500 },
	{ Id = "Profit1000", Name = "第一桶金", Description = "累積賺到 1,000 星幣的差價", Stat = "TotalProfit", Goal = 1000, Reward = 200 },
	{ Id = "Profit10000", Name = "星際富翁", Description = "累積賺到 10,000 星幣的差價", Stat = "TotalProfit", Goal = 10000, Reward = 2000 },
	{ Id = "Spot5", Name = "火眼金睛", Description = "識破假貨並趕走 5 個騙子", Stat = "FakesSpotted", Goal = 5, Reward = 200 },
	{ Id = "Spot30", Name = "騙子剋星", Description = "識破假貨並趕走 30 個騙子", Stat = "FakesSpotted", Goal = 30, Reward = 1000 },
	{ Id = "Fooled3", Name = "交學費", Description = "被假貨騙了 3 次…送你一點安慰獎", Stat = "FakesSold", Goal = 3, Reward = 100 },
	{ Id = "Shiny1", Name = "閃閃發光", Description = "收購第一件閃亮或彩虹物品", Stat = "ShiniesFound", Goal = 1, Reward = 300 },
	{ Id = "Codex10", Name = "收藏家", Description = "圖鑑收集 10 種物品", Stat = "CodexCount", Goal = 10, Reward = 500 },
	{ Id = "CodexAll", Name = "圖鑑大師", Description = "圖鑑收集全部物品", Stat = "CodexCount", Goal = ItemDatabase.Count(), Reward = 3000 },
} :: { AchievementDef }

function Achievements.GetProgress(def: AchievementDef, stats: { [string]: number }): number
	local value = stats[def.Stat] or 0
	return math.clamp(math.floor(value), 0, def.Goal)
end

-- 回傳這次新達成的成就（done 是已經領過的成就 ID 表）
function Achievements.CheckNew(done: { [string]: boolean }, stats: { [string]: number }): { AchievementDef }
	local newly = {}
	for _, def in Achievements.List do
		if not done[def.Id] and (stats[def.Stat] or 0) >= def.Goal then
			table.insert(newly, def)
		end
	end
	return newly
end

return Achievements
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000D">
        <Properties>
          <string name="Name">BargainSystem</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 議價系統：客人帶東西來「賣給」玩家，玩家出價收購。
--
-- 每位客人有：
--   Greed（貪婪度 0~1）：越貪婪，心理底價與開價越高
--   Patience（耐心值 0~100）：出價太低、鑑定太久都會扣，歸零就走人
--
-- 規則（注意方向：玩家是買方）：
--   出價 >= 客人底價 → 成交，以玩家的出價成交
--   出價 <  客人底價 → 依差距扣耐心，客人回一個還價
--   耐心歸零         → DealFailed，客人生氣離開
--
-- 這個模組是純計算、沒有隨機，方便測試與調整數值。

export type NegotiateResult = {
	Success: boolean,
	DealFailed: boolean,
	NewPatience: number,
	NPCResponseText: string,
	FinalPrice: number?,
	CounterOffer: number?,
}

local BargainSystem = {}

-- 數值參數
BargainSystem.FloorBase = 0.55 -- 最不貪婪的客人：底價 = 基礎價值 × 0.55
BargainSystem.FloorGreed = 0.35 -- 最貪婪的客人：底價 = 基礎價值 × 0.90
BargainSystem.AskBase = 1.15 -- 開價 = 基礎價值 × (1.15 ~ 1.50)
BargainSystem.AskGreed = 0.35
BargainSystem.MinPenalty = 8 -- 出價低於底價時至少扣多少耐心
BargainSystem.GapPenalty = 42 -- 差距越大扣越多（最多再加這麼多）

local function clamp01(x: number): number
	if x ~= x then
		return 0
	end
	return math.clamp(x, 0, 1)
end

-- 回傳 (底價, 開價)
function BargainSystem.GetPrices(itemBaseValue: number, customerGreed: number): (number, number)
	local greed = clamp01(customerGreed)
	local floorPrice = math.max(1, math.floor(itemBaseValue * (BargainSystem.FloorBase + BargainSystem.FloorGreed * greed) + 0.5))
	local askingPrice = math.max(floorPrice, math.floor(itemBaseValue * (BargainSystem.AskBase + BargainSystem.AskGreed * greed) + 0.5))
	return floorPrice, askingPrice
end

function BargainSystem.Negotiate(
	playerOffer: number,
	itemBaseValue: number,
	customerPatience: number,
	customerGreed: number
): NegotiateResult
	if type(playerOffer) ~= "number" or playerOffer ~= playerOffer or playerOffer < 1 or playerOffer == math.huge then
		return {
			Success = false,
			DealFailed = false,
			NewPatience = customerPatience,
			NPCResponseText = "你要出多少？說個數字啊。",
		}
	end

	local offer = math.floor(playerOffer)
	local floorPrice, askingPrice = BargainSystem.GetPrices(itemBaseValue, customerGreed)

	if offer >= floorPrice then
		local text
		if offer >= askingPrice then
			text = "成交！你真是個爽快的老闆！"
		elseif offer >= floorPrice * 1.15 then
			text = "成交，合作愉快。"
		else
			text = "唉…好吧，成交。算你厲害。"
		end
		return {
			Success = true,
			DealFailed = false,
			NewPatience = customerPatience,
			NPCResponseText = text,
			FinalPrice = offer,
		}
	end

	local gapRatio = (floorPrice - offer) / floorPrice
	local penalty = math.ceil(BargainSystem.MinPenalty + gapRatio * BargainSystem.GapPenalty)
	local newPatience = math.max(0, customerPatience - penalty)

	if newPatience <= 0 then
		return {
			Success = false,
			DealFailed = true,
			NewPatience = 0,
			NPCResponseText = "你這是在侮辱我！我去別家賣！",
		}
	end

	-- 耐心越少，還價越接近底價（但永遠不會低於底價）
	local counter = floorPrice + math.ceil((askingPrice - floorPrice) * (newPatience / 100))
	counter = math.clamp(counter, floorPrice, askingPrice)

	local text
	if gapRatio < 0.1 then
		text = string.format("就差一點點了…%d 星幣，不能再少了。", counter)
	elseif gapRatio < 0.35 then
		text = string.format("這價格太低了吧…%d 星幣怎麼樣？", counter)
	else
		text = string.format("你在開玩笑嗎？至少也要 %d 星幣！", counter)
	end

	return {
		Success = false,
		DealFailed = false,
		NewPatience = newPatience,
		NPCResponseText = text,
		CounterOffer = counter,
	}
end

return BargainSystem
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000E">
        <Properties>
          <string name="Name">Cargo</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 商人的貨物：資源種類、採集地點、收購商（不同地方收購價不一樣）。
--
-- 身上的一件貨物（CargoItem）可能是：
--   資源：{ Kind = "Resource", Resource = "StarOre", Stolen = false }
--   遺物：{ Kind = "Relic", Item = ItemInstance, Stolen = false }
--   （遺物就是當舖裡的那些物品，真假不明，可以賣給當舖）

local ItemDatabase = require(script.Parent.ItemDatabase)

export type CargoItem = {
	Kind: string,
	Resource: string?,
	Item: ItemDatabase.ItemInstance?,
	Stolen: boolean,
}

local Cargo = {}

Cargo.Resources = {
	StarOre = { Name = "星礦", BasePrice = 40, Color = { 0.55, 0.6, 0.95 } },
	AlienParts = { Name = "外星零件", BasePrice = 55, Color = { 0.5, 0.95, 0.6 } },
	EnergyCrystal = { Name = "能量水晶", BasePrice = 80, Color = { 1, 0.5, 0.85 } },
}

-- 採集地點：每次採集隨機得到 Drops 其中一種（依權重），另外有 RelicChance 機率挖到遺物
Cargo.Points = {
	Mine = {
		Name = "隕石礦場",
		Drops = { { Resource = "StarOre", Weight = 75 }, { Resource = "EnergyCrystal", Weight = 25 } },
		RelicChance = 0.12,
		HoldDuration = 1.2,
	},
	Crash = {
		Name = "飛碟墜毀點",
		Drops = { { Resource = "AlienParts", Weight = 80 }, { Resource = "EnergyCrystal", Weight = 20 } },
		RelicChance = 0.18,
		HoldDuration = 1.2,
	},
}

-- 收購商：Multipliers 是對各資源基礎價格的倍率；RelicRate 是收遺物時付「基礎價值」的幾成
Cargo.Buyers = {
	TradingPost = {
		Name = "貿易站",
		Multipliers = { StarOre = 1.25, AlienParts = 0.8, EnergyCrystal = 1.0 },
		RelicRate = 0.3,
		AcceptsStolen = false,
	},
	Institute = {
		Name = "研究院",
		Multipliers = { StarOre = 0.7, AlienParts = 1.4, EnergyCrystal = 1.2 },
		RelicRate = 0.3,
		AcceptsStolen = false,
	},
	BlackMarket = {
		Name = "黑市",
		Multipliers = { StarOre = 0.6, AlienParts = 0.6, EnergyCrystal = 0.6 },
		RelicRate = 0.2,
		AcceptsStolen = true,
	},
}

function Cargo.ResourceName(resource: string?): string
	local info = resource and Cargo.Resources[resource] or nil
	return info and info.Name or "貨物"
end

function Cargo.DisplayName(item: CargoItem): string
	local name
	if item.Kind == "Relic" and item.Item then
		name = "遺物：" .. ItemDatabase.GetDisplayName(item.Item.ItemId, item.Item.Variant)
	else
		name = Cargo.ResourceName(item.Resource)
	end
	if item.Stolen then
		name ..= "（贓物）"
	end
	return name
end

-- 決定這次採集得到什麼
function Cargo.RollDrop(pointId: string, rand: () -> number): CargoItem?
	local point = Cargo.Points[pointId]
	if not point then
		return nil
	end
	if rand() < point.RelicChance then
		return { Kind = "Relic", Stolen = false }
	end
	local total = 0
	for _, drop in point.Drops do
		total += drop.Weight
	end
	local roll = rand() * total
	for _, drop in point.Drops do
		roll -= drop.Weight
		if roll < 0 then
			return { Kind = "Resource", Resource = drop.Resource, Stolen = false }
		end
	end
	return { Kind = "Resource", Resource = point.Drops[#point.Drops].Resource, Stolen = false }
end

-- 這件貨物大約值多少（給搶劫保險、顯示用）
function Cargo.BaseValue(item: CargoItem): number
	if item.Kind == "Relic" and item.Item then
		return math.floor(ItemDatabase.GetEffectiveBase(item.Item) * 0.3)
	end
	local info = item.Resource and Cargo.Resources[item.Resource] or nil
	return info and info.BasePrice or 0
end

-- 某個收購商願意出多少（不收的話回傳 nil）
-- demand 是目前這種資源的市場行情倍率（預設 1）
function Cargo.Quote(buyerId: string, item: CargoItem, demand: number?): number?
	local buyer = Cargo.Buyers[buyerId]
	if not buyer then
		return nil
	end
	if item.Stolen and not buyer.AcceptsStolen then
		return nil
	end
	if item.Kind == "Relic" then
		if not item.Item then
			return nil
		end
		local def = ItemDatabase.Get(item.Item.ItemId)
		if not def then
			return nil
		end
		return math.max(1, math.floor(def.BaseValue * ItemDatabase.GetVariantMultiplier(item.Item.Variant) * buyer.RelicRate))
	end
	local info = item.Resource and Cargo.Resources[item.Resource] or nil
	if not info then
		return nil
	end
	local multiplier = buyer.Multipliers[item.Resource :: string] or 1
	return math.max(1, math.floor(info.BasePrice * multiplier * (demand or 1) + 0.5))
end

return Cargo
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000F">
        <Properties>
          <string name="Name">CodexSystem</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 圖鑑與套裝加成。
--
-- 圖鑑 (codex) 的格式：{ [物品ID] = "Normal" | "Shiny" | "Rainbow" }，記錄收購過的最高變種。
-- （舊存檔裡的 true 會被當成 "Normal"。）
--
-- 套裝：集齊指定物品（或累積指定數量的閃亮 / 彩虹物品）就得到永久加成。
-- 加成種類：
--   SellBonus   市場賣價 +X（0.05 = +5%）
--   Patience    客人初始耐心 +X
--   Reputation  每賣出一件真品額外 +X 名聲

local ItemDatabase = require(script.Parent.ItemDatabase)

export type Bonus = { Type: string, Value: number }

export type SetDef = {
	Id: string,
	Name: string,
	Description: string,
	Items: { string }?,
	ShinyCount: number?,
	Bonus: Bonus,
}

export type Bonuses = {
	SellBonus: number,
	Patience: number,
	Reputation: number,
}

local CodexSystem = {}

CodexSystem.Sets = {
	{
		Id = "MonsterFan",
		Name = "怪獸研究員",
		Description = "集齊所有生物類物品 → 市場賣價 +5%",
		Items = { "Item_001", "Item_010", "Item_013", "Item_017" },
		Bonus = { Type = "SellBonus", Value = 0.05 },
	},
	{
		Id = "Foodie",
		Name = "美食獵人",
		Description = "集齊所有美食類物品 → 客人耐心 +10",
		Items = { "Item_009", "Item_011", "Item_018" },
		Bonus = { Type = "Patience", Value = 10 },
	},
	{
		Id = "Gearhead",
		Name = "軍火與科技迷",
		Description = "集齊所有武器與科技類物品 → 市場賣價 +5%",
		Items = { "Item_002", "Item_012", "Item_006", "Item_016", "Item_021" },
		Bonus = { Type = "SellBonus", Value = 0.05 },
	},
	{
		Id = "TreasureHunter",
		Name = "尋寶專家",
		Description = "集齊所有寶藏類物品 → 賣出真品時名聲 +1",
		Items = { "Item_003", "Item_004", "Item_014", "Item_020" },
		Bonus = { Type = "Reputation", Value = 1 },
	},
	{
		Id = "Mystic",
		Name = "神秘學大師",
		Description = "集齊所有神秘遺物 → 客人耐心 +15",
		Items = { "Item_005", "Item_007", "Item_008", "Item_015", "Item_019" },
		Bonus = { Type = "Patience", Value = 15 },
	},
	{
		Id = "ShinyCollector",
		Name = "閃亮收藏家",
		Description = "收購 5 種閃亮或彩虹物品 → 市場賣價 +10%",
		ShinyCount = 5,
		Bonus = { Type = "SellBonus", Value = 0.1 },
	},
} :: { SetDef }

-- 圖鑑裡這一格的變種等級：沒收集 = -1、普通 = 0、閃亮 = 1、彩虹 = 2
function CodexSystem.VariantRank(value: any): number
	if value == nil or value == false then
		return -1
	end
	if value == true then
		return 0
	end
	local info = ItemDatabase.Variants[value]
	return info and info.Rank or 0
end

-- 把一次收購記進圖鑑。回傳 (是不是新物品, 是不是更高級的變種)
function CodexSystem.Record(codex: { [string]: any }, itemId: string, variant: string?): (boolean, boolean)
	local newValue = variant or "Normal"
	local oldRank = CodexSystem.VariantRank(codex[itemId])
	local newRank = CodexSystem.VariantRank(newValue)
	if oldRank < 0 then
		codex[itemId] = newValue
		return true, newRank > 0
	end
	if newRank > oldRank then
		codex[itemId] = newValue
		return false, true
	end
	return false, false
end

function CodexSystem.Count(codex: { [string]: any }): number
	local count = 0
	for _, item in ItemDatabase.GetAll() do
		if CodexSystem.VariantRank(codex[item.ID]) >= 0 then
			count += 1
		end
	end
	return count
end

function CodexSystem.ShinyCount(codex: { [string]: any }): number
	local count = 0
	for _, item in ItemDatabase.GetAll() do
		if CodexSystem.VariantRank(codex[item.ID]) >= 1 then
			count += 1
		end
	end
	return count
end

-- 回傳 (已收集數, 需要的總數)
function CodexSystem.GetSetProgress(codex: { [string]: any }, set: SetDef): (number, number)
	if set.ShinyCount then
		return math.min(CodexSystem.ShinyCount(codex), set.ShinyCount), set.ShinyCount
	end
	local items = set.Items or {}
	local have = 0
	for _, itemId in items do
		if CodexSystem.VariantRank(codex[itemId]) >= 0 then
			have += 1
		end
	end
	return have, #items
end

function CodexSystem.IsSetComplete(codex: { [string]: any }, set: SetDef): boolean
	local have, total = CodexSystem.GetSetProgress(codex, set)
	return total > 0 and have >= total
end

-- 依玩家存檔算出目前所有套裝加成的總和，以及已完成的套裝 ID
function CodexSystem.CheckSetBonus(playerData: any): (Bonuses, { [string]: boolean })
	local codex = (type(playerData) == "table" and type(playerData.Codex) == "table") and playerData.Codex or {}
	local bonuses: Bonuses = { SellBonus = 0, Patience = 0, Reputation = 0 }
	local completed: { [string]: boolean } = {}
	for _, set in CodexSystem.Sets do
		if CodexSystem.IsSetComplete(codex, set) then
			completed[set.Id] = true
			local bonusType = set.Bonus.Type
			if bonusType == "SellBonus" then
				bonuses.SellBonus += set.Bonus.Value
			elseif bonusType == "Patience" then
				bonuses.Patience += set.Bonus.Value
			elseif bonusType == "Reputation" then
				bonuses.Reputation += set.Bonus.Value
			end
		end
	end
	return bonuses, completed
end

return CodexSystem
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000010">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 遊戲的全域設定。數值平衡、Gamepass ID 都集中在這裡，改數字不用動邏輯。

local Config = {
	-- 暫定名稱，正式上架前可以再改
	GameTitle = "星塵當舖",

	-- 倉庫格數（ExtraStorage Gamepass 會再加上 ExtraStorageSlots）
	InventorySlots = 12,
	ExtraStorageSlots = 12,

	-- 救急金：倉庫空了、星幣又低於 Threshold 時，叫下一位客人會自動把星幣補到 Amount，
	-- 避免玩家買到假貨後連最便宜的東西都買不起而卡關。
	Bailout = {
		Threshold = 70,
		Amount = 150,
	},

	-- 固定鏡頭：true 時鏡頭永遠固定在櫃檯後方（單人版用）。
	-- 多人小鎮版設 false：平常是一般第三人稱鏡頭，只有在櫃檯營業時才固定。
	FixedCamera = false,

	-- 稀有變種出現的機率（閃亮版價值 ×3、彩虹版價值 ×10）
	Variants = {
		ShinyChance = 0.06,
		RainbowChance = 0.01,
	},

	-- 每日登入獎勵（星幣）：連續第 1、2、3… 天，超過之後維持最後一個數字
	DailyRewards = { 100, 150, 200, 300, 400, 500, 1000 },

	-- 稱號：名聲達到 MinReputation 就升級（要照名聲由小到大排）
	Ranks = {
		{ MinReputation = 0, Title = "菜鳥店員" },
		{ MinReputation = 10, Title = "見習鑑定師" },
		{ MinReputation = 25, Title = "老練店長" },
		{ MinReputation = 50, Title = "星際古董商" },
		{ MinReputation = 100, Title = "銀河鑑定大師" },
		{ MinReputation = 200, Title = "宇宙傳奇當舖王" },
	},

	-- 銀河新聞多久換一則（秒）
	NewsInterval = 240,

	-- 兌換碼 → 星幣。每個玩家每組碼只能用一次。可以拿來做宣傳（影片、Discord）。
	-- 一律用大寫英數字。
	Codes = {
		STARDUST = 200,
		WELCOME = 100,
	},

	-- 名聲變化
	Reputation = {
		SellReal = 2, -- 賣出真品
		SellFake = -3, -- 賣出假貨被市場拆穿
		CustomerStormedOff = -1, -- 把客人氣走
	},

	-- 在 Roblox Creator Hub 建好 Gamepass 後，把 ID 填進來。0 代表尚未建立（視為沒有購買）。
	GamePasses = {
		VIPScanner = 0, -- 高級天眼掃描儀：顯示物品的假貨機率
		Empath = 0, -- 讀心眼鏡：顯示客人的心理底價
		ExtraStorage = 0, -- 宇宙倉庫擴建：倉庫 +12 格
		DoubleReputation = 0, -- 雙倍名聲
		BodyguardBot = 0, -- 私人機器人保鑣：每 5 分鐘自動擋下一次搶劫
		BigBackpack = 0, -- 大背包：可以多帶 6 件貨物
	},

	-- 多人小鎮 ------------------------------------------------------------------
	Town = {
		MaxPlayers = 20, -- 每個伺服器的人數（要在 Game Settings 裡設定，這裡只是記錄）
		NewbieProtection = 600, -- 剛進遊戲幾秒內不會被搶
		CargoCapacity = 6, -- 每個人身上最多帶幾件貨物
		BigBackpackBonus = 6,

		-- 搶劫
		RobRange = 10, -- 要離目標多近才能搶
		RobCooldown = 20, -- 搶完要等幾秒才能再搶
		RobShare = 0.5, -- 一次搶走身上幾成的貨物
		RobReputationPenalty = 5, -- 每搶一次扣多少名聲
		BodyguardCooldown = 300, -- 機器人保鑣擋下一次後要冷卻幾秒

		-- 通緝與坐牢
		MaxWanted = 5,
		WantedDecay = 90, -- 多少秒沒做壞事，通緝等級降一級
		JailPerLevel = 20, -- 每一級通緝要關幾秒
		BountyPerLevel = 100, -- 保鑣抓到人，每一級通緝拿多少賞金
		ArrestRange = 10,
		ArrestReputationReward = 2,
		NpcGuardRange = 14, -- 通緝犯靠近廣場 NPC 警衛多近會被抓

		-- 護送
		EscortRange = 25, -- 保鑣在多近的距離內算護送中（護送中不會被搶）
		EscortPayInterval = 10, -- 每幾秒發一次護送費
		EscortPay = 6,

		-- 用星幣買的保險：被搶時拿回這次損失的幾成，用一次就沒了
		Insurance = { Price = 250, Refund = 0.6, MaxStack = 3 },

		-- 店面
		CounterRange = 18, -- 店長離開櫃檯多遠就自動打烊
		MerchantQueueLimit = 3, -- 每間當舖最多排幾件玩家商人寄賣的遺物
	},

	-- 存檔
	DataStoreName = "PlayerData_v1",
	AutosaveInterval = 120, -- 秒

	-- 每位玩家兩次請求之間的最短間隔（秒），防止腳本狂刷
	RequestCooldown = 0.15,
}

return Config
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000011">
        <Properties>
          <string name="Name">Crime</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 犯罪規則（純計算）：能不能搶、搶走多少、通緝、坐牢、賞金。
-- 所有數值都在 Config.Town。

local Config = require(script.Parent.Config)

export type RobContext = {
	RobberJob: string?,
	RobberJailed: boolean,
	RobberOnCooldown: boolean,
	RobberFreeSlots: number,
	VictimJailed: boolean,
	VictimCargo: number,
	VictimInSafeZone: boolean,
	VictimNewbie: boolean,
	VictimEscorted: boolean,
	RobberInSafeZone: boolean,
	Distance: number,
	SameActor: boolean,
}

local Crime = {}

-- 回傳 (可以搶嗎, 不行的原因)
function Crime.CanRob(ctx: RobContext): (boolean, string?)
	local town = Config.Town
	if ctx.SameActor then
		return false, "不能搶自己。"
	end
	if ctx.RobberJailed then
		return false, "你在坐牢，乖一點。"
	end
	if ctx.RobberJob == "Guard" then
		return false, "保鑣不能搶劫，先去廣場換職業。"
	end
	if ctx.RobberOnCooldown then
		return false, "剛搶完，等一下再動手。"
	end
	if ctx.Distance > town.RobRange then
		return false, "離太遠了。"
	end
	if ctx.VictimJailed then
		return false, "對方在坐牢。"
	end
	if ctx.VictimInSafeZone or ctx.RobberInSafeZone then
		return false, "這裡是安全區，不能搶劫。"
	end
	if ctx.VictimNewbie then
		return false, "對方還在新手保護期。"
	end
	if ctx.VictimEscorted then
		return false, "對方有保鑣護送，不敢下手。"
	end
	if ctx.VictimCargo <= 0 then
		return false, "對方身上沒有貨物。"
	end
	if ctx.RobberFreeSlots <= 0 then
		return false, "你身上已經塞滿了。"
	end
	return true, nil
end

-- 會被搶走幾件（至少 1 件，不超過搶劫者身上的空位）
function Crime.RobCount(victimCargo: number, robberFreeSlots: number): number
	local count = math.max(1, math.ceil(victimCargo * Config.Town.RobShare))
	return math.min(count, victimCargo, robberFreeSlots)
end

function Crime.AddWanted(current: number, amount: number): number
	return math.clamp(current + amount, 0, Config.Town.MaxWanted)
end

-- 經過 elapsed 秒沒犯罪後，通緝等級會變成多少
function Crime.DecayWanted(current: number, elapsed: number): number
	if current <= 0 then
		return 0
	end
	local drop = math.floor(elapsed / Config.Town.WantedDecay)
	return math.max(0, current - drop)
end

function Crime.JailSeconds(wanted: number): number
	return math.max(1, wanted) * Config.Town.JailPerLevel
end

function Crime.Bounty(wanted: number): number
	return math.max(0, wanted) * Config.Town.BountyPerLevel
end

function Crime.InsuranceRefund(lostValue: number): number
	return math.floor(lostValue * Config.Town.Insurance.Refund)
end

-- 點是否在某個方塊區域裡（區域用中心點、大小表示，不考慮旋轉）
function Crime.InBox(point: Vector3, center: Vector3, size: Vector3): boolean
	local d = point - center
	return math.abs(d.X) <= size.X / 2 and math.abs(d.Y) <= size.Y / 2 and math.abs(d.Z) <= size.Z / 2
end

return Crime
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000012">
        <Properties>
          <string name="Name">CustomerGenerator</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 隨機產生一位客人與他帶來的物品。
-- rand 是一個回傳 [0, 1) 的函式，由伺服器傳入（測試時可以傳固定值）。

local BargainSystem = require(script.Parent.BargainSystem)
local Config = require(script.Parent.Config)
local ItemDatabase = require(script.Parent.ItemDatabase)

export type Customer = {
	Id: string,
	Name: string,
	Species: string,
	Color: { number },
	Greeting: string,
	LastLine: string,
	Item: ItemDatabase.ItemInstance,
	Greed: number,
	Patience: number,
	MaxPatience: number,
	Floor: number,
	AskingPrice: number,
	CurrentAsk: number,
}

export type Options = {
	Patience: number?, -- 客人的初始耐心（預設 100）
	FakeChanceBonus: ((ItemDatabase.ItemDef) -> number)?, -- 額外的假貨機率（例如銀河新聞）
	ShinyChance: number?,
	RainbowChance: number?,
}

local CustomerGenerator = {}

local PROFILES = {
	{ Name = "格洛克", Species = "沼澤星人", Color = { 0.45, 0.8, 0.35 } },
	{ Name = "紅鬍子", Species = "太空海盜", Color = { 0.85, 0.3, 0.25 } },
	{ Name = "奇奇", Species = "流浪商人", Color = { 0.95, 0.75, 0.3 } },
	{ Name = "茲布-札布", Species = "雙頭星人", Color = { 0.6, 0.4, 0.9 } },
	{ Name = "諾娃", Species = "星雲精靈", Color = { 0.4, 0.75, 0.95 } },
	{ Name = "布魯姆", Species = "岩石族", Color = { 0.6, 0.55, 0.5 } },
	{ Name = "嗶嗶-7", Species = "流浪機器人", Color = { 0.75, 0.8, 0.85 } },
	{ Name = "蜜拉", Species = "觸手族", Color = { 0.95, 0.45, 0.7 } },
	{ Name = "噗噗", Species = "果凍星人", Color = { 0.5, 0.95, 0.8 } },
	{ Name = "阿土伯", Species = "太空農夫", Color = { 0.8, 0.6, 0.4 } },
}

local GREETINGS = {
	"嘿，老闆！看看這個寶貝。",
	"我急需星幣，這個便宜賣你。",
	"這可是傳家寶，要不是缺錢我才不賣。",
	"別問我從哪弄來的，你要不要？",
	"我在小行星帶撿到的，應該很值錢吧？",
	"聽說你這裡最識貨，我就直接來了。",
	"我媽叫我把房間清乾淨，所以這個賣你。",
	"噓…小聲一點，這個東西很厲害。",
}

local VARIANT_GREETINGS = {
	"你看你看！這個會發光耶，一定超值錢！",
	"我從來沒看過這麼亮的，你一定要收！",
}

local function pick<T>(list: { T }, rand: () -> number): T
	local index = math.clamp(1 + math.floor(rand() * #list), 1, #list)
	return list[index]
end

local function pickItem(reputation: number, rand: () -> number): ItemDatabase.ItemDef
	local pool = ItemDatabase.GetEligible(reputation)
	if #pool == 0 then
		pool = ItemDatabase.GetAll()
	end
	-- 名聲越高，越容易遇到稀有的客人
	local rareBoost = 1 + reputation / 50
	local weights = {}
	local total = 0
	for i, item in pool do
		local w = ItemDatabase.RarityWeights[item.Rarity] or 1
		if item.Rarity ~= "Common" then
			w *= rareBoost
		end
		weights[i] = w
		total += w
	end
	local roll = rand() * total
	for i, item in pool do
		roll -= weights[i]
		if roll < 0 then
			return item
		end
	end
	return pool[#pool]
end

-- 由指定的物品產生一位客人（例如玩家商人寄賣的遺物）
function CustomerGenerator.FromItem(instance: ItemDatabase.ItemInstance, name: string, species: string, greed: number, id: string?): Customer
	local floorPrice, askingPrice = BargainSystem.GetPrices(ItemDatabase.GetEffectiveBase(instance), greed)
	local greeting = "我在城外挖到這個，你看值多少？"
	return {
		Id = id or tostring(math.random(1, 1e9)),
		Name = name,
		Species = species,
		Color = { 0.95, 0.75, 0.3 },
		Greeting = greeting,
		LastLine = greeting,
		Item = instance,
		Greed = greed,
		Patience = 100,
		MaxPatience = 100,
		Floor = floorPrice,
		AskingPrice = askingPrice,
		CurrentAsk = askingPrice,
	}
end

function CustomerGenerator.Generate(reputation: number, rand: () -> number, id: string?, options: Options?): Customer
	local opts: Options = options or {}
	local def = pickItem(reputation, rand)
	local attrs = def.InspectionAttributes

	-- 稀有變種
	local rainbowChance = opts.RainbowChance or Config.Variants.RainbowChance
	local shinyChance = opts.ShinyChance or Config.Variants.ShinyChance
	local variantRoll = rand()
	local variant = "Normal"
	if variantRoll < rainbowChance then
		variant = "Rainbow"
	elseif variantRoll < rainbowChance + shinyChance then
		variant = "Shiny"
	end

	local fakeChance = attrs.FakeChance
	if opts.FakeChanceBonus then
		fakeChance = math.clamp(fakeChance + opts.FakeChanceBonus(def), 0, 0.9)
	end
	local isFake = rand() < fakeChance
	local defectType: string? = nil
	if not isFake and rand() < attrs.Defect.Chance then
		defectType = attrs.Defect.Type
	end

	local instance: ItemDatabase.ItemInstance = {
		ItemId = def.ID,
		IsFake = isFake,
		DefectType = defectType,
		Variant = variant,
	}

	local greed = rand()
	local floorPrice, askingPrice = BargainSystem.GetPrices(ItemDatabase.GetEffectiveBase(instance), greed)
	local profile = pick(PROFILES, rand)
	local greeting = pick(GREETINGS, rand)
	if variant ~= "Normal" then
		greeting = pick(VARIANT_GREETINGS, rand)
	end
	local patience = opts.Patience or 100

	return {
		Id = id or tostring(math.floor(rand() * 1e9)),
		Name = profile.Name,
		Species = profile.Species,
		Color = profile.Color,
		Greeting = greeting,
		LastLine = greeting,
		Item = instance,
		Greed = greed,
		Patience = patience,
		MaxPatience = patience,
		Floor = floorPrice,
		AskingPrice = askingPrice,
		CurrentAsk = askingPrice,
	}
end

return CustomerGenerator
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000013">
        <Properties>
          <string name="Name">GalacticNews</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 銀河新聞：每隔一段時間換一則，影響某一類物品的市場賣價與假貨機率。
-- 新增新聞只要在 Events 裡加一筆。
--
-- 玩法上的意義：收購價不受新聞影響，但賣價會變，
-- 所以玩家可以把東西囤在倉庫，等對的新聞出現再賣。

export type NewsEvent = {
	Id: string,
	Title: string,
	Description: string,
	Category: string?, -- 影響的物品分類（nil = 沒有影響）
	PriceMultiplier: number, -- 該分類的市場賣價倍率
	FakeChanceBonus: number, -- 該分類的假貨機率加成
	Weight: number,
}

local GalacticNews = {}

GalacticNews.Events = {
	{ Id = "Calm", Title = "平靜的一天", Description = "銀河系今天沒什麼大事，市場價格正常。", Category = nil, PriceMultiplier = 1, FakeChanceBonus = 0, Weight = 3 },
	{ Id = "War", Title = "星際戰爭爆發！", Description = "武器的市場賣價變成 2 倍，但假貨也變多了。", Category = "Weapon", PriceMultiplier = 2, FakeChanceBonus = 0.15, Weight = 2 },
	{ Id = "FoodFest", Title = "銀河美食節開幕", Description = "美食類的市場賣價變成 2 倍！", Category = "Food", PriceMultiplier = 2, FakeChanceBonus = 0, Weight = 2 },
	{ Id = "GoldRush", Title = "小行星淘金熱", Description = "寶藏類的市場賣價變成 1.6 倍，假貨也跟著變多。", Category = "Treasure", PriceMultiplier = 1.6, FakeChanceBonus = 0.1, Weight = 2 },
	{ Id = "TechExpo", Title = "宇宙科技展", Description = "科技類的市場賣價變成 1.7 倍！", Category = "Tech", PriceMultiplier = 1.7, FakeChanceBonus = 0, Weight = 2 },
	{ Id = "MonsterShow", Title = "怪獸選美大賽", Description = "生物類的市場賣價變成 1.8 倍！", Category = "Creature", PriceMultiplier = 1.8, FakeChanceBonus = 0, Weight = 2 },
	{ Id = "CurseBan", Title = "帝國取締詛咒物品", Description = "神秘遺物變得很搶手，市場賣價 1.8 倍，但假貨大增。", Category = "Relic", PriceMultiplier = 1.8, FakeChanceBonus = 0.15, Weight = 2 },
} :: { NewsEvent }

function GalacticNews.Get(id: string): NewsEvent
	for _, event in GalacticNews.Events do
		if event.Id == id then
			return event
		end
	end
	return GalacticNews.Events[1]
end

-- 依權重隨機挑一則新聞（不會連續兩次一樣）
function GalacticNews.Pick(rand: () -> number, excludeId: string?): NewsEvent
	local pool = {}
	local total = 0
	for _, event in GalacticNews.Events do
		if event.Id ~= excludeId then
			table.insert(pool, event)
			total += event.Weight
		end
	end
	if #pool == 0 then
		return GalacticNews.Events[1]
	end
	local roll = rand() * total
	for _, event in pool do
		roll -= event.Weight
		if roll < 0 then
			return event
		end
	end
	return pool[#pool]
end

function GalacticNews.GetPriceMultiplier(event: NewsEvent?, category: string?): number
	if event and event.Category ~= nil and event.Category == category then
		return event.PriceMultiplier
	end
	return 1
end

function GalacticNews.GetFakeChanceBonus(event: NewsEvent?, category: string?): number
	if event and event.Category ~= nil and event.Category == category then
		return event.FakeChanceBonus
	end
	return 0
end

return GalacticNews
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000014">
        <Properties>
          <string name="Name">ItemDatabase</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- 物品資料庫：所有可典當的宇宙物品，以及它們的鑑定特徵。
--
-- 新增物品只要在 Items 裡加一筆，不需要改 UI 或議價邏輯。
--
-- 每個物品的 InspectionAttributes：
--   FakeChance  這件物品是假貨的機率（0~1）
--   FakeTell    用哪個工具（Tool）能分辨真假，以及真品 / 假貨時看到的描述
--   Defect      可能的瑕疵：用哪個工具能發現、出現機率、對價值的影響
--
-- 「實例」(ItemInstance) 是某位客人帶來的那一件：它是不是假貨、有沒有瑕疵，
-- 只存在伺服器端，玩家必須靠工具鑑定才知道。
-- Variant（變種）則是公開的：閃亮版價值 ×3、彩虹版價值 ×10，客人開價也會跟著變高。

export type Rarity = "Common" | "Rare" | "Epic" | "Legendary"

export type FakeTell = {
	Tool: string,
	RealText: string,
	FakeText: string,
}

export type Defect = {
	Type: string,
	DisplayName: string,
	Tool: string,
	Chance: number,
	ValueMultiplier: number,
	FoundText: string,
	CleanText: string,
}

export type ItemDef = {
	ID: string,
	Name: string,
	Description: string,
	Category: string,
	BaseValue: number,
	Rarity: Rarity,
	MinReputation: number,
	InspectionAttributes: {
		FakeChance: number,
		FakeTell: FakeTell,
		Defect: Defect,
	},
}

export type ItemInstance = {
	ItemId: string,
	IsFake: boolean,
	DefectType: string?,
	Variant: string?,
}

export type Finding = {
	Text: string,
	Tone: string, -- "good" | "bad" | "neutral"
}

local ItemDatabase = {}

ItemDatabase.RarityNames = {
	Common = "普通",
	Rare = "稀有",
	Epic = "史詩",
	Legendary = "傳說",
}

-- 抽客人時各稀有度的權重
ItemDatabase.RarityWeights = {
	Common = 60,
	Rare = 28,
	Epic = 10,
	Legendary = 2,
}

ItemDatabase.CategoryNames = {
	Creature = "生物",
	Weapon = "武器",
	Treasure = "寶藏",
	Tech = "科技",
	Relic = "神秘遺物",
	Food = "美食",
}

-- 變種：Rank 越大越稀有
ItemDatabase.Variants = {
	Normal = { Name = "", Multiplier = 1, Rank = 0 },
	Shiny = { Name = "閃亮", Multiplier = 3, Rank = 1 },
	Rainbow = { Name = "彩虹", Multiplier = 10, Rank = 2 },
}

local Items: { ItemDef } = {
	-- 名聲 0：開店就會遇到 ------------------------------------------------------
	{
		ID = "Item_009",
		Name = "會跳舞的外星香蕉",
		Description = "放在桌上會自己扭來扭去。據說吃了會停不下來一直跳舞。",
		Category = "Food",
		BaseValue = 80,
		Rarity = "Common",
		MinReputation = 0,
		InspectionAttributes = {
			FakeChance = 0.25,
			FakeTell = { Tool = "Magnifier", RealText = "香蕉皮上有細小的外星斑點，而且還在扭動。真貨！", FakeText = "只是普通香蕉貼了一對塑膠眼睛…" },
			Defect = { Type = "Overripe", DisplayName = "熟過頭", Tool = "XRay", Chance = 0.25, ValueMultiplier = 0.6, FoundText = "X 光顯示裡面已經熟到變黑了。", CleanText = "X 光下果肉新鮮飽滿。" },
		},
	},
	{
